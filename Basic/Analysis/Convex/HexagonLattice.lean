/-!
# Lattice tilings by centrally symmetric hexagons

A centrally symmetric hexagon (possibly degenerate: a parallelogram) in normal form,
`symmHexagon u v α β = {x | |⟨u, x⟩| ≤ 1, |⟨v, x⟩| ≤ 1, |⟨α u + β v, x⟩| ≤ 1}` with `u, v`
independent and `α, β ≥ 0`, is a fundamental domain of a lattice `ℤ w₁ + ℤ w₂`:

* `PlaneConvex.exists_lattice_symmHexagon`: the translates by the lattice cover the plane, and
  every nonzero lattice vector `l` has `|⟨u, l⟩| ≥ 2`, `|⟨v, l⟩| ≥ 2` or `|⟨α u + β v, l⟩| ≥ 2`, so
  the translates have pairwise disjoint interiors.

If the third (resp. first, second) constraint is implied by the other two, the hexagon is a
parallelogram and the lattice is `{l | ⟨u', l⟩, ⟨v', l⟩ ∈ 2ℤ}` for the two remaining normals.
Otherwise `|α - β| < 1 < α + β` and the lattice is generated by `w₁, w₂` with
`(⟨u, w₁⟩, ⟨v, w₁⟩) = (2, -B)`, `(⟨u, w₂⟩, ⟨v, w₂⟩) = (-A, 2)`, `A = (α + β - 1)/α`,
`B = (α + β - 1)/β`; the covering is proved by the Voronoi argument: the hexagon is the
Voronoi cell of the lattice for the positive definite quadratic form
`Φ = 2α⟨u,·⟩² + 2(α + β - 1)⟨u,·⟩⟨v,·⟩ + 2β⟨v,·⟩²` (`PlaneConvex.hexForm`), so a lattice point
nearest to `x` for `Φ` (one exists, the sublevel sets being finite) puts `x` in the translated
hexagon (`PlaneConvex.hexagon_voronoi`).

* `PlaneConvex.circPolygon_symm_eq_symmHexagon`: a circumscribed hexagon `|⟨u_i, x⟩| ≤ h_K(u_i)`,
  `i < 3`, of a centrally symmetric convex disk `K` with finite area is such a `symmHexagon`
  (otherwise it is a slab, of infinite area, `PlaneConvex.volume_slab_eq_top`).
-/

@[expose] public section

open Set

namespace PlaneConvex

/-- The determinant `det(u, v) = u₀ v₁ - u₁ v₀`. -/
def cross (u v : Fin 2 → ℝ) : ℝ := u 0 * v 1 - u 1 * v 0

/-- The centrally symmetric hexagon `|⟨u, x⟩| ≤ 1`, `|⟨v, x⟩| ≤ 1`, `|⟨α u + β v, x⟩| ≤ 1`. -/
def symmHexagon (u v : Fin 2 → ℝ) (α β : ℝ) : Set (Fin 2 → ℝ) :=
  {x | |u ⬝ᵥ x| ≤ 1 ∧ |v ⬝ᵥ x| ≤ 1 ∧ |(α • u + β • v) ⬝ᵥ x| ≤ 1}

/-- The vector `e` with `⟨u, e⟩ = 1`, `⟨v, e⟩ = 0` (if `det(u, v) ≠ 0`). -/
noncomputable def dualVec (u v : Fin 2 → ℝ) : Fin 2 → ℝ := (cross u v)⁻¹ • ![v 1, -v 0]

theorem cross_swap (u v : Fin 2 → ℝ) : cross v u = -cross u v := by
  unfold cross; ring

theorem cross_smul_add_right (u v : Fin 2 → ℝ) (α β : ℝ) :
    cross u (α • u + β • v) = β * cross u v := by
  simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring

theorem cross_smul_add_left (u v : Fin 2 → ℝ) (α β : ℝ) :
    cross v (α • u + β • v) = -(α * cross u v) := by
  simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring

theorem dotProduct_dualVec_self {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) :
    u ⬝ᵥ dualVec u v = 1 := by
  have : u ⬝ᵥ ![v 1, -v 0] = cross u v := by
    simp [dotProduct, Fin.sum_univ_two, cross]; ring
  rw [dualVec, dotProduct_smul, smul_eq_mul, this, inv_mul_cancel₀ h]

theorem dotProduct_dualVec_other (u v : Fin 2 → ℝ) : v ⬝ᵥ dualVec u v = 0 := by
  have : v ⬝ᵥ ![v 1, -v 0] = 0 := by
    simp [dotProduct, Fin.sum_univ_two]; ring
  rw [dualVec, dotProduct_smul, smul_eq_mul, this, mul_zero]

theorem smul_add_dotProduct (α β : ℝ) (u v x : Fin 2 → ℝ) :
    (α • u + β • v) ⬝ᵥ x = α * (u ⬝ᵥ x) + β * (v ⬝ᵥ x) := by
  rw [add_dotProduct, smul_dotProduct, smul_dotProduct, smul_eq_mul, smul_eq_mul]

theorem eq_dualVec_add {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) (x : Fin 2 → ℝ) :
    x = (u ⬝ᵥ x) • dualVec u v + (v ⬝ᵥ x) • dualVec v u := by
  have h' : cross v u ≠ 0 := by rw [cross_swap]; exact neg_ne_zero.2 h
  ext i
  fin_cases i <;>
  · simp only [dualVec, dotProduct, Fin.sum_univ_two, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [cross_swap]
    field_simp
    unfold cross
    ring

/-- A parallelogram `|⟨u, x⟩| ≤ R`, `|⟨v, x⟩| ≤ R` with `u, v` independent is bounded. -/
theorem isBounded_parallelogram {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) (R : ℝ) :
    Bornology.IsBounded {x | |u ⬝ᵥ x| ≤ R ∧ |v ⬝ᵥ x| ≤ R} := by
  refine (Metric.isBounded_closedBall (x := 0)
    (r := R * ‖dualVec u v‖ + R * ‖dualVec v u‖)).subset fun x hx ↦ ?_
  rw [mem_closedBall_zero_iff, eq_dualVec_add h x]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_) <;> rw [norm_smul, Real.norm_eq_abs]
  · exact mul_le_mul_of_nonneg_right hx.1 (norm_nonneg _)
  · exact mul_le_mul_of_nonneg_right hx.2 (norm_nonneg _)

theorem isBounded_symmHexagon {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) (α β : ℝ) :
    Bornology.IsBounded (symmHexagon u v α β) :=
  (isBounded_parallelogram h 1).subset fun _ hx ↦ ⟨hx.1, hx.2.1⟩

theorem abs_sub_two_mul_round_le (t : ℝ) : |t - 2 * ⌊t / 2 + 1 / 2⌋| ≤ 1 := by
  have h1 := Int.floor_le (t / 2 + 1 / 2)
  have h2 := Int.lt_floor_add_one (t / 2 + 1 / 2)
  rw [abs_le]
  constructor <;> linarith

/-- The lattice of a parallelogram `|⟨u, x⟩| ≤ 1`, `|⟨v, x⟩| ≤ 1`. -/
theorem exists_lattice_parallelogram {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) :
    ∃ w₁ w₂ : Fin 2 → ℝ, LinearIndependent ℝ ![w₁, w₂] ∧
      (∀ m n : ℤ, u ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂) = 2 * m ∧
        v ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂) = 2 * n) ∧
      ∀ x, ∃ m n : ℤ, |u ⬝ᵥ (x - ((m : ℝ) • w₁ + (n : ℝ) • w₂))| ≤ 1 ∧
        |v ⬝ᵥ (x - ((m : ℝ) • w₁ + (n : ℝ) • w₂))| ≤ 1 := by
  have h' : cross v u ≠ 0 := by rw [cross_swap]; exact neg_ne_zero.2 h
  have hc : ∀ s t : ℝ, u ⬝ᵥ (s • (2 • dualVec u v) + t • (2 • dualVec v u)) = 2 * s ∧
      v ⬝ᵥ (s • (2 • dualVec u v) + t • (2 • dualVec v u)) = 2 * t := by
    intro s t
    simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, dotProduct_dualVec_self h,
      dotProduct_dualVec_self h', dotProduct_dualVec_other]
    constructor <;> ring
  refine ⟨2 • dualVec u v, 2 • dualVec v u, ?_, fun m n ↦ hc m n, fun x ↦ ?_⟩
  · rw [LinearIndependent.pair_iff]
    intro s t hst
    have h1 := (hc s t).1
    have h2 := (hc s t).2
    rw [hst, dotProduct_zero] at h1 h2
    constructor <;> linarith
  · refine ⟨⌊u ⬝ᵥ x / 2 + 1 / 2⌋, ⌊v ⬝ᵥ x / 2 + 1 / 2⌋, ?_, ?_⟩
    · rw [dotProduct_sub, (hc _ _).1]
      exact abs_sub_two_mul_round_le _
    · rw [dotProduct_sub, (hc _ _).2]
      exact abs_sub_two_mul_round_le _

/-- The quadratic form `2αF² + 2cFG + 2βG²`, positive definite if `c² < 4αβ`, `α > 0`. -/
def hexForm (α β c F G : ℝ) : ℝ := 2 * α * F ^ 2 + 2 * c * F * G + 2 * β * G ^ 2

theorem two_mul_hexForm (α β c F G : ℝ) :
    2 * α * hexForm α β c F G = (2 * α * F + c * G) ^ 2 + (4 * α * β - c ^ 2) * G ^ 2 := by
  unfold hexForm; ring

theorem two_mul_hexForm' (α β c F G : ℝ) :
    2 * β * hexForm α β c F G = (2 * β * G + c * F) ^ 2 + (4 * α * β - c ^ 2) * F ^ 2 := by
  unfold hexForm; ring

/-- The changes of `hexForm` under the six neighbouring lattice translations. -/
theorem hexForm_sub {α β c A B : ℝ} (F G : ℝ) (hα : 0 < α) (hβ : 0 < β)
    (hc : c = α + β - 1) (hA : A = c / α) (hB : B = c / β) :
    hexForm α β c (F - 2) (G + B) - hexForm α β c F G = 2 * α * (4 - A * B) * (1 - F) ∧
    hexForm α β c (F + 2) (G - B) - hexForm α β c F G = 2 * α * (4 - A * B) * (1 + F) ∧
    hexForm α β c (F + A) (G - 2) - hexForm α β c F G = 2 * β * (4 - A * B) * (1 - G) ∧
    hexForm α β c (F - A) (G + 2) - hexForm α β c F G = 2 * β * (4 - A * B) * (1 + G) ∧
    hexForm α β c (F - 2 + A) (G + B - 2) - hexForm α β c F G =
      2 * (4 - A * B) * (1 - (α * F + β * G)) ∧
    hexForm α β c (F + 2 - A) (G - B + 2) - hexForm α β c F G =
      2 * (4 - A * B) * (1 + (α * F + β * G)) := by
  subst hA hB hc
  simp only [hexForm]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> field_simp <;> ring

/-- **The Voronoi argument.** For `|α - β| < 1 < α + β` and any `p, q`, some integers `m, n` put
`(F, G) = (p - (2m - A n), q - (-B m + 2n))` in the hexagon `|F|, |G|, |αF + βG| ≤ 1`, where
`A = (α + β - 1)/α`, `B = (α + β - 1)/β`: take `(m, n)` minimizing the positive definite form
`hexForm α β (α + β - 1) F G`. -/
theorem hexagon_voronoi (p q : ℝ) {α β : ℝ} (hα : 0 < α) (hβ : 0 < β) (h1 : 1 < α + β)
    (h2 : α < 1 + β) (h3 : β < 1 + α) :
    ∃ m n : ℤ, |p - (2 * m - (α + β - 1) / α * n)| ≤ 1 ∧
      |q - (-((α + β - 1) / β) * m + 2 * n)| ≤ 1 ∧
      |α * (p - (2 * m - (α + β - 1) / α * n)) +
        β * (q - (-((α + β - 1) / β) * m + 2 * n))| ≤ 1 := by
  obtain ⟨c, hcdef⟩ : ∃ c, c = α + β - 1 := ⟨_, rfl⟩
  obtain ⟨A, hAdef⟩ : ∃ A, A = c / α := ⟨_, rfl⟩
  obtain ⟨B, hBdef⟩ : ∃ B, B = c / β := ⟨_, rfl⟩
  rw [← hcdef, ← hAdef, ← hBdef]
  have hc : 0 < c := by rw [hcdef]; linarith
  have hA : 0 < A := hAdef ▸ div_pos hc hα
  have hB : 0 < B := hBdef ▸ div_pos hc hβ
  have hαA : α * A = c := by rw [hAdef]; field_simp
  have hβB : β * B = c := by rw [hBdef]; field_simp
  have hΔ' : 0 < 4 * α * β - c ^ 2 := by rw [hcdef]; nlinarith
  have hAB : A * B < 4 := by
    have : α * β * (A * B) = c ^ 2 := by
      calc α * β * (A * B) = (α * A) * (β * B) := by ring
        _ = c ^ 2 := by rw [hαA, hβB]; ring
    nlinarith [mul_pos hα hβ]
  have hD : 0 < 4 - A * B := by linarith
  have hnn : ∀ F G, 0 ≤ hexForm α β c F G := by
    intro F G
    have h0 : 0 ≤ 2 * α * hexForm α β c F G := by rw [two_mul_hexForm]; positivity
    exact (mul_nonneg_iff_of_pos_left (by linarith)).1 h0
  set f : ℤ × ℤ → ℝ := fun mn ↦
    hexForm α β c (p - (2 * mn.1 - A * mn.2)) (q - (-B * mn.1 + 2 * mn.2)) with hf
  obtain ⟨Φ0, hΦ0def⟩ : ∃ Φ0, Φ0 = f (0, 0) := ⟨_, rfl⟩
  have hΦ0 : 0 ≤ Φ0 := hΦ0def ▸ hnn _ _
  obtain ⟨X, hXdef⟩ : ∃ X, X = 1 + 2 * β * Φ0 / (4 * α * β - c ^ 2) := ⟨_, rfl⟩
  obtain ⟨Y, hYdef⟩ : ∃ Y, Y = 1 + 2 * α * Φ0 / (4 * α * β - c ^ 2) := ⟨_, rfl⟩
  have hX : 0 ≤ X := by rw [hXdef]; positivity
  have hY : 0 ≤ Y := by rw [hYdef]; positivity
  have hcoer : ∀ F G : ℝ, hexForm α β c F G ≤ Φ0 → |F| ≤ X ∧ |G| ≤ Y := by
    intro F G hFG
    have hF : F ^ 2 ≤ 2 * β * Φ0 / (4 * α * β - c ^ 2) := by
      rw [le_div_iff₀ hΔ']
      have := two_mul_hexForm' α β c F G
      nlinarith [sq_nonneg (2 * β * G + c * F)]
    have hG : G ^ 2 ≤ 2 * α * Φ0 / (4 * α * β - c ^ 2) := by
      rw [le_div_iff₀ hΔ']
      have := two_mul_hexForm α β c F G
      nlinarith [sq_nonneg (2 * α * F + c * G)]
    rw [hXdef, hYdef]
    constructor
    · nlinarith [sq_abs F, abs_nonneg F, sq_nonneg (|F| - 1)]
    · nlinarith [sq_abs G, abs_nonneg G, sq_nonneg (|G| - 1)]
  obtain ⟨Mb, hMbdef⟩ : ∃ Mb, Mb = (2 * (|p| + X) + A * (|q| + Y)) / (4 - A * B) := ⟨_, rfl⟩
  obtain ⟨Nb, hNbdef⟩ : ∃ Nb, Nb = (B * (|p| + X) + 2 * (|q| + Y)) / (4 - A * B) := ⟨_, rfl⟩
  have hMb : 0 ≤ Mb := hMbdef ▸ div_nonneg (by positivity) hD.le
  have hNb : 0 ≤ Nb := hNbdef ▸ div_nonneg (by positivity) hD.le
  obtain ⟨N, hN⟩ : ∃ N : ℤ, Mb + Nb ≤ N := ⟨⌈Mb + Nb⌉, Int.le_ceil _⟩
  set S : Set (ℤ × ℤ) := {mn | f mn ≤ Φ0}
  have hSsub : S ⊆ Icc (-N) N ×ˢ Icc (-N) N := by
    rintro ⟨m, n⟩ hmn
    obtain ⟨hF, hG⟩ := hcoer _ _ hmn
    have hFm : |2 * (m : ℝ) - A * n| ≤ |p| + X := by
      rw [show 2 * (m : ℝ) - A * n = p - (p - (2 * m - A * n)) by ring]
      exact (abs_sub _ _).trans (by linarith only [hF])
    have hGm : |-B * (m : ℝ) + 2 * n| ≤ |q| + Y := by
      rw [show -B * (m : ℝ) + 2 * n = q - (q - (-B * m + 2 * n)) by ring]
      exact (abs_sub _ _).trans (by linarith only [hG])
    have hm : |(m : ℝ)| ≤ Mb := by
      rw [hMbdef, le_div_iff₀ hD]
      calc |(m : ℝ)| * (4 - A * B) = |2 * (2 * m - A * n) + A * (-B * m + 2 * n)| := by
            rw [← abs_of_pos hD, ← abs_mul]; congr 1; ring
        _ ≤ 2 * |2 * (m : ℝ) - A * n| + A * |-B * (m : ℝ) + 2 * n| := by
            refine (abs_add_le _ _).trans (le_of_eq ?_)
            rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2), abs_of_pos hA]
        _ ≤ 2 * (|p| + X) + A * (|q| + Y) := by gcongr
    have hn : |(n : ℝ)| ≤ Nb := by
      rw [hNbdef, le_div_iff₀ hD]
      calc |(n : ℝ)| * (4 - A * B) = |B * (2 * m - A * n) + 2 * (-B * m + 2 * n)| := by
            rw [← abs_of_pos hD, ← abs_mul]; congr 1; ring
        _ ≤ B * |2 * (m : ℝ) - A * n| + 2 * |-B * (m : ℝ) + 2 * n| := by
            refine (abs_add_le _ _).trans (le_of_eq ?_)
            rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2), abs_of_pos hB]
        _ ≤ B * (|p| + X) + 2 * (|q| + Y) := by gcongr
    have hm' := abs_le.1 hm
    have hn' := abs_le.1 hn
    have a1 : -N ≤ m := by
      have : -(N : ℝ) ≤ m := by linarith only [hm'.1, hN, hNb]
      exact_mod_cast this
    have a2 : m ≤ N := by
      have : (m : ℝ) ≤ N := by linarith only [hm'.2, hN, hNb]
      exact_mod_cast this
    have a3 : -N ≤ n := by
      have : -(N : ℝ) ≤ n := by linarith only [hn'.1, hN, hMb]
      exact_mod_cast this
    have a4 : n ≤ N := by
      have : (n : ℝ) ≤ N := by linarith only [hn'.2, hN, hMb]
      exact_mod_cast this
    exact ⟨⟨a1, a2⟩, ⟨a3, a4⟩⟩
  have hSfin : S.Finite := ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _)).subset hSsub
  have h00 : ((0 : ℤ), (0 : ℤ)) ∈ S := by
    change f (0, 0) ≤ Φ0
    rw [hΦ0def]
  obtain ⟨⟨m, n⟩, hmnS, hmin⟩ := Set.exists_min_image S f hSfin ⟨_, h00⟩
  have hnb : ∀ m' n' : ℤ, f (m, n) ≤ f (m', n') := by
    intro m' n'
    by_cases h' : (m', n') ∈ S
    · exact hmin _ h'
    · exact le_trans hmnS (le_of_lt (not_le.1 h'))
  set F := p - (2 * (m : ℝ) - A * n) with hFdef
  set G := q - (-B * (m : ℝ) + 2 * n) with hGdef
  have hfmn : f (m, n) = hexForm α β c F G := rfl
  obtain ⟨i1, i2, i3, i4, i5, i6⟩ := hexForm_sub (A := A) (B := B) F G hα hβ hcdef hAdef hBdef
  have e1 : f (m, n) ≤ hexForm α β c (F - 2) (G + B) := by
    convert hnb (m + 1) n using 2 <;> simp only [F, G] <;> push_cast <;> ring
  have e2 : f (m, n) ≤ hexForm α β c (F + 2) (G - B) := by
    convert hnb (m - 1) n using 2 <;> simp only [F, G] <;> push_cast <;> ring
  have e3 : f (m, n) ≤ hexForm α β c (F + A) (G - 2) := by
    convert hnb m (n + 1) using 2 <;> simp only [F, G] <;> push_cast <;> ring
  have e4 : f (m, n) ≤ hexForm α β c (F - A) (G + 2) := by
    convert hnb m (n - 1) using 2 <;> simp only [F, G] <;> push_cast <;> ring
  have e5 : f (m, n) ≤ hexForm α β c (F - 2 + A) (G + B - 2) := by
    convert hnb (m + 1) (n + 1) using 2 <;> simp only [F, G] <;> push_cast <;> ring
  have e6 : f (m, n) ≤ hexForm α β c (F + 2 - A) (G - B + 2) := by
    convert hnb (m - 1) (n - 1) using 2 <;> simp only [F, G] <;> push_cast <;> ring
  rw [hfmn] at e1 e2 e3 e4 e5 e6
  have hαD : 0 < 2 * α * (4 - A * B) := by positivity
  have hβD : 0 < 2 * β * (4 - A * B) := by positivity
  have hD2 : 0 < 2 * (4 - A * B) := by positivity
  have k1 : 0 ≤ 2 * α * (4 - A * B) * (1 - F) := by linarith only [e1, i1]
  have k2 : 0 ≤ 2 * α * (4 - A * B) * (1 + F) := by linarith only [e2, i2]
  have k3 : 0 ≤ 2 * β * (4 - A * B) * (1 - G) := by linarith only [e3, i3]
  have k4 : 0 ≤ 2 * β * (4 - A * B) * (1 + G) := by linarith only [e4, i4]
  have k5 : 0 ≤ 2 * (4 - A * B) * (1 - (α * F + β * G)) := by linarith only [e5, i5]
  have k6 : 0 ≤ 2 * (4 - A * B) * (1 + (α * F + β * G)) := by linarith only [e6, i6]
  have l1 := (mul_nonneg_iff_of_pos_left hαD).1 k1
  have l2 := (mul_nonneg_iff_of_pos_left hαD).1 k2
  have l3 := (mul_nonneg_iff_of_pos_left hβD).1 k3
  have l4 := (mul_nonneg_iff_of_pos_left hβD).1 k4
  have l5 := (mul_nonneg_iff_of_pos_left hD2).1 k5
  have l6 := (mul_nonneg_iff_of_pos_left hD2).1 k6
  refine ⟨m, n, ?_, ?_, ?_⟩
  · rw [abs_le]; constructor <;> linarith only [l1, l2]
  · rw [abs_le]; constructor <;> linarith only [l3, l4]
  · rw [abs_le]; constructor <;> linarith only [l5, l6]

/-- The lattice of a genuine centrally symmetric hexagon (`|α - β| < 1 < α + β`). -/
theorem exists_lattice_symmHexagon_of_lt {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) {α β : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (h1 : 1 < α + β) (h2 : α < 1 + β) (h3 : β < 1 + α) :
    ∃ w₁ w₂ : Fin 2 → ℝ, LinearIndependent ℝ ![w₁, w₂] ∧
      (∀ x, ∃ m n : ℤ, x - ((m : ℝ) • w₁ + (n : ℝ) • w₂) ∈ symmHexagon u v α β) ∧
      ∀ m n : ℤ, (m ≠ 0 ∨ n ≠ 0) →
        2 ≤ |u ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| ∨ 2 ≤ |v ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| ∨
          2 ≤ |(α • u + β • v) ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| := by
  have h' : cross v u ≠ 0 := by rw [cross_swap]; exact neg_ne_zero.2 h
  set c := α + β - 1 with hcdef
  have hc : 0 < c := by linarith
  set A := c / α with hAdef
  set B := c / β with hBdef
  have hA : 0 < A := div_pos hc hα
  have hB : 0 < B := div_pos hc hβ
  have hαA : α * A = c := by rw [hAdef]; field_simp
  have hβB : β * B = c := by rw [hBdef]; field_simp
  have hΔ' : 0 < 4 * α * β - c ^ 2 := by nlinarith
  have hAB : A * B < 4 := by
    have : α * β * (A * B) = c ^ 2 := by
      calc α * β * (A * B) = (α * A) * (β * B) := by ring
        _ = c ^ 2 := by rw [hαA, hβB]; ring
    nlinarith [mul_pos hα hβ]
  set e₁ := dualVec u v
  set e₂ := dualVec v u
  set w₁ := (2 : ℝ) • e₁ - B • e₂
  set w₂ := (-A) • e₁ + (2 : ℝ) • e₂
  have hcoord : ∀ s t : ℝ, u ⬝ᵥ (s • w₁ + t • w₂) = 2 * s - A * t ∧
      v ⬝ᵥ (s • w₁ + t • w₂) = -B * s + 2 * t := by
    intro s t
    simp only [w₁, w₂, e₁, e₂, dotProduct_add, dotProduct_sub, dotProduct_smul, smul_eq_mul,
      dotProduct_dualVec_self h, dotProduct_dualVec_self h', dotProduct_dualVec_other]
    constructor <;> ring
  refine ⟨w₁, w₂, ?_, ?_, ?_⟩
  · -- linear independence
    rw [LinearIndependent.pair_iff]
    intro s t hst
    have e1 := (hcoord s t).1
    have e2 := (hcoord s t).2
    rw [hst, dotProduct_zero] at e1 e2
    have hs : (4 - A * B) * s = 0 := by linear_combination (-2) * e1 - A * e2
    have hs0 : s = 0 := (mul_eq_zero.1 hs).resolve_left (by linarith)
    refine ⟨hs0, ?_⟩
    subst hs0
    linarith
  · -- covering, by the Voronoi argument
    intro x
    obtain ⟨m, n, hF, hG, hH⟩ := hexagon_voronoi (u ⬝ᵥ x) (v ⬝ᵥ x) hα hβ h1 h2 h3
    have hu : u ⬝ᵥ (x - ((m : ℝ) • w₁ + (n : ℝ) • w₂)) = u ⬝ᵥ x - (2 * m - A * n) := by
      rw [dotProduct_sub, (hcoord _ _).1]
    have hv : v ⬝ᵥ (x - ((m : ℝ) • w₁ + (n : ℝ) • w₂)) = v ⬝ᵥ x - (-B * m + 2 * n) := by
      rw [dotProduct_sub, (hcoord _ _).2]
    refine ⟨m, n, ?_, ?_, ?_⟩
    · rw [hu]; exact hF
    · rw [hv]; exact hG
    · rw [smul_add_dotProduct, hu, hv]; exact hH
  · -- packing
    intro m n hmn
    have hF := (hcoord m n).1
    have hG := (hcoord m n).2
    have hH : (α • u + β • v) ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂) =
        m * (2 * α - c) + n * (2 * β - c) := by
      rw [smul_add_dotProduct, hF, hG]
      linear_combination (-(n : ℝ)) * hαA - (m : ℝ) * hβB
    rw [hF, hG, hH]
    have h2α : 0 < 2 * α - c := by linarith
    have h2β : 0 < 2 * β - c := by linarith
    have hsum : (2 * α - c) + (2 * β - c) = 2 := by rw [hcdef]; ring
    rcases lt_trichotomy m 0 with hm | rfl | hm <;> rcases lt_trichotomy n 0 with hn | rfl | hn
    · have hm' : (m : ℝ) ≤ -1 := by exact_mod_cast (show m ≤ -1 by omega)
      have hn' : (n : ℝ) ≤ -1 := by exact_mod_cast (show n ≤ -1 by omega)
      right; right; rw [le_abs]; right; nlinarith
    · have hm' : (m : ℝ) ≤ -1 := by exact_mod_cast (show m ≤ -1 by omega)
      left; rw [le_abs]; right; push_cast; nlinarith
    · have hm' : (m : ℝ) ≤ -1 := by exact_mod_cast (show m ≤ -1 by omega)
      have hn' : (0 : ℝ) ≤ n := by exact_mod_cast hn.le
      left; rw [le_abs]; right; nlinarith
    · have hn' : (n : ℝ) ≤ -1 := by exact_mod_cast (show n ≤ -1 by omega)
      right; left; rw [le_abs]; right; push_cast; linarith
    · exact absurd hmn (by simp)
    · have hn' : (1 : ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n by omega)
      right; left; rw [le_abs]; left; push_cast; linarith
    · have hm' : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
      have hn' : (n : ℝ) ≤ 0 := by exact_mod_cast hn.le
      left; rw [le_abs]; left; nlinarith
    · have hm' : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
      left; rw [le_abs]; left; push_cast; linarith
    · have hm' : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
      have hn' : (1 : ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n by omega)
      right; right; rw [le_abs]; left; nlinarith

theorem two_le_abs_two_mul_intCast {m : ℤ} (hm : m ≠ 0) : 2 ≤ |2 * (m : ℝ)| := by
  have h1 : (1 : ℝ) ≤ |(m : ℝ)| := by
    rw [← Int.cast_abs]
    exact_mod_cast Int.one_le_abs hm
  rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  linarith

theorem abs_smul_add_dotProduct_le {α β : ℝ} (hα : 0 ≤ α) (hβ : 0 ≤ β) (u v x : Fin 2 → ℝ) :
    |(α • u + β • v) ⬝ᵥ x| ≤ α * |u ⬝ᵥ x| + β * |v ⬝ᵥ x| := by
  rw [smul_add_dotProduct]
  refine (abs_add_le _ _).trans (le_of_eq ?_)
  rw [abs_mul, abs_mul, abs_of_nonneg hα, abs_of_nonneg hβ]

/-- **Lattice tiling by a centrally symmetric hexagon.** The hexagon
`symmHexagon u v α β` (`u, v` independent, `α, β ≥ 0`) is a fundamental domain of a lattice
`ℤ w₁ + ℤ w₂`: its translates cover the plane, and every nonzero lattice vector `l` has
`|⟨u, l⟩| ≥ 2`, `|⟨v, l⟩| ≥ 2` or `|⟨α u + β v, l⟩| ≥ 2` (so the translates do not overlap). -/
theorem exists_lattice_symmHexagon {u v : Fin 2 → ℝ} (h : cross u v ≠ 0) {α β : ℝ}
    (hα : 0 ≤ α) (hβ : 0 ≤ β) :
    ∃ w₁ w₂ : Fin 2 → ℝ, LinearIndependent ℝ ![w₁, w₂] ∧
      (∀ x, ∃ m n : ℤ, x - ((m : ℝ) • w₁ + (n : ℝ) • w₂) ∈ symmHexagon u v α β) ∧
      ∀ m n : ℤ, (m ≠ 0 ∨ n ≠ 0) →
        2 ≤ |u ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| ∨ 2 ≤ |v ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| ∨
          2 ≤ |(α • u + β • v) ⬝ᵥ ((m : ℝ) • w₁ + (n : ℝ) • w₂)| := by
  by_cases hA : α + β ≤ 1
  · -- a parallelogram: the third constraint is implied
    obtain ⟨w₁, w₂, hli, hco, hcov⟩ := exists_lattice_parallelogram h
    refine ⟨w₁, w₂, hli, fun x ↦ ?_, fun m n hmn ↦ ?_⟩
    · obtain ⟨m, n, h1, h2⟩ := hcov x
      refine ⟨m, n, h1, h2, (abs_smul_add_dotProduct_le hα hβ u v _).trans ?_⟩
      nlinarith
    · rw [(hco m n).1, (hco m n).2]
      rcases hmn with hm | hn
      · exact Or.inl (two_le_abs_two_mul_intCast hm)
      · exact Or.inr (Or.inl (two_le_abs_two_mul_intCast hn))
  by_cases hB : 1 + β ≤ α
  · -- a parallelogram: the first constraint is implied
    have h' : cross v (α • u + β • v) ≠ 0 := by
      rw [cross_smul_add_left]
      exact neg_ne_zero.2 (mul_ne_zero (by linarith) h)
    obtain ⟨w₁, w₂, hli, hco, hcov⟩ := exists_lattice_parallelogram h'
    refine ⟨w₁, w₂, hli, fun x ↦ ?_, fun m n hmn ↦ ?_⟩
    · obtain ⟨m, n, h1, h2⟩ := hcov x
      refine ⟨m, n, ?_, h1, h2⟩
      set y := x - ((m : ℝ) • w₁ + (n : ℝ) • w₂)
      rw [smul_add_dotProduct] at h2
      have h3 : α * |u ⬝ᵥ y| ≤ 1 + β := by
        calc α * |u ⬝ᵥ y| = |α * (u ⬝ᵥ y) + β * (v ⬝ᵥ y) - β * (v ⬝ᵥ y)| := by
              rw [add_sub_cancel_right, abs_mul, abs_of_nonneg hα]
          _ ≤ |α * (u ⬝ᵥ y) + β * (v ⬝ᵥ y)| + |β * (v ⬝ᵥ y)| := abs_sub _ _
          _ ≤ 1 + β := by
              rw [abs_mul, abs_of_nonneg hβ]
              nlinarith
      by_contra hcon
      nlinarith
    · rw [(hco m n).1, (hco m n).2]
      rcases hmn with hm | hn
      · exact Or.inr (Or.inl (two_le_abs_two_mul_intCast hm))
      · exact Or.inr (Or.inr (two_le_abs_two_mul_intCast hn))
  by_cases hC : 1 + α ≤ β
  · -- a parallelogram: the second constraint is implied
    have h' : cross u (α • u + β • v) ≠ 0 := by
      rw [cross_smul_add_right]
      exact mul_ne_zero (by linarith) h
    obtain ⟨w₁, w₂, hli, hco, hcov⟩ := exists_lattice_parallelogram h'
    refine ⟨w₁, w₂, hli, fun x ↦ ?_, fun m n hmn ↦ ?_⟩
    · obtain ⟨m, n, h1, h2⟩ := hcov x
      refine ⟨m, n, h1, ?_, h2⟩
      set y := x - ((m : ℝ) • w₁ + (n : ℝ) • w₂)
      rw [smul_add_dotProduct] at h2
      have h3 : β * |v ⬝ᵥ y| ≤ 1 + α := by
        calc β * |v ⬝ᵥ y| = |α * (u ⬝ᵥ y) + β * (v ⬝ᵥ y) - α * (u ⬝ᵥ y)| := by
              rw [add_sub_cancel_left, abs_mul, abs_of_nonneg hβ]
          _ ≤ |α * (u ⬝ᵥ y) + β * (v ⬝ᵥ y)| + |α * (u ⬝ᵥ y)| := abs_sub _ _
          _ ≤ 1 + α := by
              rw [abs_mul, abs_of_nonneg hα]
              nlinarith
      by_contra hcon
      nlinarith
    · rw [(hco m n).1, (hco m n).2]
      rcases hmn with hm | hn
      · exact Or.inl (two_le_abs_two_mul_intCast hm)
      · exact Or.inr (Or.inr (two_le_abs_two_mul_intCast hn))
  · exact exists_lattice_symmHexagon_of_lt h (by linarith) (by linarith) (by linarith)
      (by linarith) (by linarith)

/-! ### Circumscribed centrally symmetric hexagons in normal form -/

section Reduction

open MeasureTheory Real

variable {K : Set (Fin 2 → ℝ)}

theorem cross_dir (a b : ℝ) : cross (dir a) (dir b) = Real.sin (b - a) := by
  simp [cross, dir, Real.sin_sub]; ring

theorem dir_sub_int_mul_pi (θ : ℝ) (k : ℤ) :
    dir (θ - k * π) = dir θ ∨ dir (θ - k * π) = -dir θ := by
  obtain ⟨j, rfl | rfl⟩ := Int.even_or_odd' k
  · left
    push_cast
    rw [show θ - 2 * (j : ℝ) * π = θ - j * (2 * π) by ring, dir_sub_int_mul_two_pi]
  · right
    push_cast
    rw [show θ - (2 * (j : ℝ) + 1) * π = (θ - π) - j * (2 * π) by ring, dir_sub_int_mul_two_pi]
    have := dir_add_pi (θ - π)
    rw [sub_add_cancel] at this
    rw [this, neg_neg]

theorem dir_dotProduct_self (θ : ℝ) : dir θ ⬝ᵥ dir θ = 1 := by
  rw [dir_dotProduct]
  simp only [dir, Matrix.cons_val_zero, Matrix.cons_val_one]
  nlinarith [Real.sin_sq_add_cos_sq θ]

/-- The support function of a centrally symmetric convex disk is positive. -/
theorem supportFun_dir_pos (hK : IsCompact K) (hint : (interior K).Nonempty)
    (hsymm : ∀ x ∈ K, -x ∈ K) (θ : ℝ) : 0 < supportFun K (dir θ) := by
  obtain ⟨x, hx⟩ := hint
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 (mem_interior_iff_mem_nhds.1 hx)
  set δ := ε / 2
  have hδ : 0 < δ := by positivity
  have hnorm : ‖δ • dir θ‖ < ε := by
    refine lt_of_le_of_lt ((pi_norm_le_iff_of_nonneg hδ.le).2 fun i ↦ ?_) (by simp [δ]; linarith)
    fin_cases i <;> simp [dir, abs_of_pos hδ] <;>
      nlinarith [Real.abs_cos_le_one θ, Real.abs_sin_le_one θ]
  have h1 : x + δ • dir θ ∈ K := hball (by simpa [dist_eq_norm] using hnorm)
  have h2 : x - δ • dir θ ∈ K := hball (by simpa [dist_eq_norm, norm_neg] using hnorm)
  have e1 := dotProduct_le_supportFun hK (dir θ) h1
  have e2 := dotProduct_le_supportFun hK (-dir θ) h2
  rw [supportFun_neg hsymm] at e2
  simp only [dotProduct_add, dotProduct_sub, dotProduct_smul, smul_eq_mul, neg_dotProduct,
    dir_dotProduct_self] at e1 e2
  linarith

/-- A slab has infinite area. -/
theorem volume_slab_eq_top (θ : ℝ) {m : ℝ} (hm : 0 < m) :
    volume {x : Fin 2 → ℝ | |dir θ ⬝ᵥ x| ≤ m} = ⊤ := by
  let M : Matrix (Fin 2) (Fin 2) ℝ := !![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ]
  have hdet : |M.det| = 1 := by
    have : M.det = 1 := by
      simp [M, Matrix.det_fin_two]
      nlinarith [Real.sin_sq_add_cos_sq θ]
    rw [this, abs_one]
  refine ENNReal.eq_top_of_forall_nnreal_le fun r ↦ ?_
  set T := (r : ℝ) / (4 * m) + 1
  have hT : 0 < T := by positivity
  have hsub : Matrix.toLin' M '' Icc ![-m, -T] ![m, T] ⊆ {x | |dir θ ⬝ᵥ x| ≤ m} := by
    rintro _ ⟨y, hy, rfl⟩
    have h0 : -m ≤ y 0 := by simpa using hy.1 0
    have h0' : y 0 ≤ m := by simpa using hy.2 0
    simp only [mem_ofPred_eq, Matrix.toLin'_apply, dir_dotProduct]
    have e : M.mulVec y 0 = Real.cos θ * y 0 - Real.sin θ * y 1 ∧
        M.mulVec y 1 = Real.sin θ * y 0 + Real.cos θ * y 1 := by
      simp only [M, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
      simp [sub_eq_add_neg]
    rw [e.1, e.2, show Real.cos θ * (Real.cos θ * y 0 - Real.sin θ * y 1) +
        Real.sin θ * (Real.sin θ * y 0 + Real.cos θ * y 1) =
        (Real.sin θ ^ 2 + Real.cos θ ^ 2) * y 0 by ring, Real.sin_sq_add_cos_sq, one_mul,
      abs_le]
    exact ⟨h0, h0'⟩
  refine le_trans ?_ (measure_mono hsub)
  rw [Measure.addHaar_image_linearMap, LinearMap.det_toLin', hdet, ENNReal.ofReal_one, one_mul,
    Real.volume_Icc_pi, Fin.prod_univ_two]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_coe_nnreal]
  apply ENNReal.ofReal_le_ofReal
  have : (r : ℝ) ≤ 4 * m * T := by
    simp only [T]
    rw [mul_add, mul_div_cancel₀ _ (by positivity)]
    nlinarith
  nlinarith

theorem abs_inv_mul_le_one_iff {H a : ℝ} (hH : 0 < H) : |H⁻¹ * a| ≤ 1 ↔ |a| ≤ H := by
  rw [abs_mul, abs_inv, abs_of_pos hH, inv_mul_le_iff₀ hH, mul_one]

/-- **Normal form of circumscribed centrally symmetric hexagons.** If `K = -K` is a convex disk,
a circumscribed hexagon with normals `±dir (c i)`, `i < 3`, of finite area is
`symmHexagon u v α β` for some independent `u, v` and `α, β ≥ 0`. -/
theorem circPolygon_symm_eq_symmHexagon (hK : IsCompact K) (hint : (interior K).Nonempty)
    (hsymm : ∀ x ∈ K, -x ∈ K) (c : Fin 3 → ℝ)
    (hfin : volume (circPolygon K (Sum.elim c fun i ↦ c i + π)) ≠ ⊤) :
    ∃ u v : Fin 2 → ℝ, ∃ α β : ℝ, cross u v ≠ 0 ∧ 0 ≤ α ∧ 0 ≤ β ∧
      circPolygon K (Sum.elim c fun i ↦ c i + π) = symmHexagon u v α β := by
  have hpos := supportFun_dir_pos hK hint hsymm
  -- reduce the angles modulo `π`
  let γ : Fin 3 → ℝ := fun i ↦ toIcoMod pi_pos 0 (c i)
  have hγr : ∀ i, 0 ≤ γ i ∧ γ i < π := fun i ↦ toIcoMod_mem_Ico' pi_pos (c i)
  have hγdir : ∀ i, dir (γ i) = dir (c i) ∨ dir (γ i) = -dir (c i) := by
    intro i
    simp only [γ, toIcoMod, zsmul_eq_mul]
    exact dir_sub_int_mul_pi _ _
  have hγabs : ∀ i x, |dir (γ i) ⬝ᵥ x| = |dir (c i) ⬝ᵥ x| := by
    intro i x
    rcases hγdir i with h | h <;> rw [h]
    rw [neg_dotProduct, abs_neg]
  have hγsupp : ∀ i, supportFun K (dir (γ i)) = supportFun K (dir (c i)) := by
    intro i
    rcases hγdir i with h | h <;> rw [h]
    rw [supportFun_neg hsymm]
  -- sort them
  let σ := Tuple.sort γ
  let g : Fin 3 → ℝ := γ ∘ σ
  have hmono : Monotone g := Tuple.monotone_sort γ
  have hg01 : g 0 ≤ g 1 := hmono (by decide)
  have hg12 : g 1 ≤ g 2 := hmono (by decide)
  have hgr : ∀ j, 0 ≤ g j ∧ g j < π := fun j ↦ hγr (σ j)
  set H : Fin 3 → ℝ := fun j ↦ supportFun K (dir (g j)) with hHdef
  have hH : ∀ j, 0 < H j := fun j ↦ hpos _
  have hset : circPolygon K (Sum.elim c fun i ↦ c i + π) =
      {x | ∀ j : Fin 3, |dir (g j) ⬝ᵥ x| ≤ H j} := by
    rw [circPolygon_symm_eq hsymm]
    ext x
    simp only [mem_ofPred_eq]
    constructor
    · intro h j
      simp only [H, g, Function.comp_apply, hγabs, hγsupp]
      exact h _
    · intro h i
      have := h (σ.symm i)
      simp only [H, g, Function.comp_apply, Equiv.apply_symm_apply, hγabs, hγsupp] at this
      exact this
  rcases eq_or_lt_of_le (hg01.trans hg12) with heq | hlt
  · -- degenerate: a slab
    exfalso
    apply hfin
    rw [hset]
    have hg1 : g 1 = g 0 := le_antisymm (heq ▸ hg12) hg01
    set m := min (H 0) (min (H 1) (H 2))
    have hm : 0 < m := lt_min (hH 0) (lt_min (hH 1) (hH 2))
    refine top_le_iff.1 ((volume_slab_eq_top (g 0) hm).symm.le.trans (measure_mono ?_))
    intro x hx j
    simp only [mem_ofPred_eq] at hx
    fin_cases j
    · exact hx.trans (min_le_left _ _)
    · simp only [Fin.mk_one, hg1]
      exact hx.trans ((min_le_right _ _).trans (min_le_left _ _))
    · simp only [Fin.reduceFinMk, ← heq]
      exact hx.trans ((min_le_right _ _).trans (min_le_right _ _))
  · -- a genuine hexagon or parallelogram
    have hπ : g 2 - g 0 < π := by linarith [hgr 0, hgr 2]
    set S := Real.sin (g 2 - g 0)
    have hS : 0 < S := Real.sin_pos_of_pos_of_lt_pi (by linarith) hπ
    have hcomb := dir_combo (θ := g 0) (φ := g 2) (ψ := g 1)
    have hs1 : 0 ≤ Real.sin (g 2 - g 1) :=
      Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)
    have hs2 : 0 ≤ Real.sin (g 1 - g 0) :=
      Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)
    set u := (H 0)⁻¹ • dir (g 0)
    set v := (H 2)⁻¹ • dir (g 2)
    set α := (H 1)⁻¹ * (S⁻¹ * Real.sin (g 2 - g 1)) * H 0
    set β := (H 1)⁻¹ * (S⁻¹ * Real.sin (g 1 - g 0)) * H 2
    have hmid : α • u + β • v = (H 1)⁻¹ • dir (g 1) := by
      have h0 : H 0 ≠ 0 := (hH 0).ne'
      have h2 : H 2 ≠ 0 := (hH 2).ne'
      have : dir (g 1) = (S⁻¹ * Real.sin (g 2 - g 1)) • dir (g 0) +
          (S⁻¹ * Real.sin (g 1 - g 0)) • dir (g 2) := by
        rw [mul_smul, mul_smul, ← smul_add, ← hcomb, smul_smul, inv_mul_cancel₀ hS.ne', one_smul]
      rw [this]
      simp only [u, v, α, β, smul_smul, smul_add]
      congr 1 <;> congr 1 <;> field_simp
    have hα : 0 ≤ α := mul_nonneg (mul_nonneg (inv_nonneg.2 (hH 1).le)
      (mul_nonneg (inv_nonneg.2 hS.le) hs1)) (hH 0).le
    have hβ : 0 ≤ β := mul_nonneg (mul_nonneg (inv_nonneg.2 (hH 1).le)
      (mul_nonneg (inv_nonneg.2 hS.le) hs2)) (hH 2).le
    refine ⟨u, v, α, β, ?_, hα, hβ, ?_⟩
    · simp only [u, v, cross, Pi.smul_apply, smul_eq_mul]
      have := cross_dir (g 0) (g 2)
      simp only [cross] at this
      have e : (H 0)⁻¹ * dir (g 0) 0 * ((H 2)⁻¹ * dir (g 2) 1) -
          (H 0)⁻¹ * dir (g 0) 1 * ((H 2)⁻¹ * dir (g 2) 0) = (H 0)⁻¹ * (H 2)⁻¹ * S := by
        rw [show S = dir (g 0) 0 * dir (g 2) 1 - dir (g 0) 1 * dir (g 2) 0 from this.symm]
        ring
      rw [e]
      exact mul_ne_zero (mul_ne_zero (inv_ne_zero (hH 0).ne') (inv_ne_zero (hH 2).ne')) hS.ne'
    · rw [hset]
      ext x
      simp only [mem_ofPred_eq, symmHexagon, hmid, smul_dotProduct, smul_eq_mul, u, v,
        abs_inv_mul_le_one_iff (hH 0), abs_inv_mul_le_one_iff (hH 1),
        abs_inv_mul_le_one_iff (hH 2)]
      constructor
      · intro h
        exact ⟨h 0, h 2, h 1⟩
      · rintro ⟨h0, h2, h1⟩ j
        fin_cases j
        · exact h0
        · exact h1
        · exact h2

/-- Interior points of a set in the slab `|⟨w, x⟩| ≤ 1` satisfy `|⟨w, x⟩| < 1`. -/
theorem interior_subset_abs_dotProduct_lt {S : Set (Fin 2 → ℝ)} {w : Fin 2 → ℝ}
    (h : S ⊆ {x | |w ⬝ᵥ x| ≤ 1}) : interior S ⊆ {x | |w ⬝ᵥ x| < 1} := by
  intro x hx
  by_cases hw : w = 0
  · simp [hw]
  have hww : 0 < w ⬝ᵥ w := by
    simp only [dotProduct, Fin.sum_univ_two]
    by_contra hcon
    apply hw
    ext i
    fin_cases i <;> simp <;> nlinarith [sq_nonneg (w 0), sq_nonneg (w 1)]
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 (mem_interior_iff_mem_nhds.1 hx)
  set t := ε / (2 * (‖w‖ + 1))
  have ht : 0 < t := by positivity
  have hnorm : ‖t • w‖ < ε := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
    simp only [t]
    rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith [norm_nonneg w]
  have hp : x + t • w ∈ S := hball (by simpa [dist_eq_norm] using hnorm)
  have hm : x - t • w ∈ S := hball (by simpa [dist_eq_norm, norm_neg] using hnorm)
  have e1 := h hp
  have e2 := h hm
  simp only [mem_ofPred_eq, dotProduct_add, dotProduct_sub, dotProduct_smul, smul_eq_mul,
    abs_le] at e1 e2 ⊢
  rw [abs_lt]
  constructor <;> nlinarith [mul_pos ht hww]

theorem interior_symmHexagon_subset (u v : Fin 2 → ℝ) (α β : ℝ) :
    interior (symmHexagon u v α β) ⊆
      {x | |u ⬝ᵥ x| < 1 ∧ |v ⬝ᵥ x| < 1 ∧ |(α • u + β • v) ⬝ᵥ x| < 1} := fun _ hx ↦
  ⟨interior_subset_abs_dotProduct_lt (S := symmHexagon u v α β) (fun _ h ↦ h.1) hx,
    interior_subset_abs_dotProduct_lt (S := symmHexagon u v α β) (fun _ h ↦ h.2.1) hx,
    interior_subset_abs_dotProduct_lt (S := symmHexagon u v α β) (fun _ h ↦ h.2.2) hx⟩

end Reduction

end PlaneConvex
