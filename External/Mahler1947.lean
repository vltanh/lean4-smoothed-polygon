module

public import External.MinkowskiMahler
public import Mathlib.Analysis.Convex.Segment
public import Mathlib.Analysis.LocallyConvex.Separation
public import Mathlib.LinearAlgebra.AffineSpace.Midpoint
public import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
public import Mathlib.MeasureTheory.Measure.Lebesgue.EqHaar

/-!
# Mahler's theorem on the circumscribed hexagons of a convex domain

Cited as Theorem 2.3.7 of Hales–Vajjha, *Packings of Smoothed Polygons*, from K. Mahler, *On the
minimum determinant and the circumscribed hexagons of a convex domain*, Proc. Kon. Ned. Akad.
Wet. 50 (1947), 692–703: let `K` be a symmetric convex domain that is not a parallelogram, `Λ` a
critical lattice of `K`, and `P₀, …, P₅` points of `Λ` on the boundary of `K` with
`P₀ - P₁ + P₂ = 0` and `P_{j+3} = -P_j`. There are unique symmetric tac-lines (support lines)
`ℓ_j` of `K` at the points `P_j` such that no two of them coincide, the hexagon `H` bounded by them
has area `4Δ(K)`, each side of `H` is bisected at the point `P_j` where it touches `K`, and `H` has
the least area among the hexagons bounded by symmetric tac-lines of `K`.

Definitions, in the terms of the source; lattices, `Δ(K)` and critical lattices are those of
`External.MinkowskiMahler`. A tac-line of `K` is a line that meets `K` and has `K` on one side. A
tac-line of a symmetric convex domain does not pass through the origin, an interior point, so it
is `ℓ = {x | a · x = 1}` for a unique vector `a`, with `K ⊆ {x | a · x ≤ 1}`; the symmetric
tac-line is `-ℓ = {x | -a · x = 1}`. Six tac-lines `ℓ_j = {x | a_j · x = 1}` bound the hexagon
`{x | a_j · x ≤ 1 for all j}`.

## Proof

We follow Mahler's proofs of Theorems 1 and 2 and prove the lemmas they use.

* `P₀, P₁` is a basis of `Λ` (another point of `Λ` would give a nonzero point of `Λ` inside `K`),
  so `|det(P₀, P₁)| = d(Λ) = Δ(K)` (`mah_lattice_eq`, `mah_setup_of`).
* Lemma 1 (`mah_adm`): the lattice generated by points `M₀, M₁, M₂ = M₁ - M₀` on the sides of a
  symmetric hexagon (or on tac-lines) has no nonzero point inside it.
* Lemmas 4 and 5, the half used in Theorem 1 (`mah_par_lower`, `mah_hex_lower`): a symmetric
  convex domain inside a parallelogram or symmetric hexagon `H` has `Δ(K) ≤ V(H)/4`, because the
  lattice generated by the midpoints of the sides of `H` is admissible and has determinant
  `V(H)/4`; the areas are computed in `mah_vol_P` and `mah_vol_H`.
* Theorem 1, `(1)` (`mah_thm1`): `4Δ(K) ≤ V(H)` for every hexagon or parallelogram `H` bounded by
  three pairs of symmetric lines and containing `K`.
* (ii) (`mah_no_common`, footnote 8): since `K` is not a parallelogram, no tac-line passes through
  two consecutive points `P_j, P_{j+1}`.
* `(3)`, (iii) and (iv) (`mah_key`): for symmetric tac-lines `a_j · x = 1` at the `P_j`, with
  `α_j = a_j · P_{j+1} ∈ (0, 1)`, the hexagon `H` they bound has area
  `V(H) = (4 - p² / (D₀ D₁ D₂)) Δ(K)`, `p = α₀α₁α₂ - (1 - α₀)(1 - α₁)(1 - α₂)`,
  `D_j = 1 - α_j + α_j α_{j+1}`. With Theorem 1 this gives `p = 0`, so `V(H) = 4Δ(K)`, and `p = 0`
  says exactly that `P_j` is the midpoint of its side.
* (i) (`mah_unique0`): `p` is strictly increasing in each `α_j`, so a second tac-line at `P_j`
  (which would also give `p = 0`) is impossible; this is Mahler's "`V(H)` would vary".
-/

@[expose] public section

namespace External

open MeasureTheory Set Matrix MinkowskiMahler

namespace Mahler1947

/-- `P` is a parallelogram: `P = {c + s u + t v | |s| ≤ 1, |t| ≤ 1}` with `u, v` linearly
independent. -/
def IsParallelogram (P : Set (Fin 2 → ℝ)) : Prop :=
  ∃ c u v : Fin 2 → ℝ, cross u v ≠ 0 ∧
    P = {x | ∃ s t : ℝ, |s| ≤ 1 ∧ |t| ≤ 1 ∧ x = c + s • u + t • v}

/-- A tac-line (support line) of `K`: a line `{x | a · x = c}`, `a ≠ 0`, that meets `K` and has
`K` on one side. -/
def IsTacLine (K ℓ : Set (Fin 2 → ℝ)) : Prop :=
  (∃ a : Fin 2 → ℝ, a ≠ 0 ∧ ∃ c : ℝ, ℓ = {x | a ⬝ᵥ x = c} ∧ ∀ x ∈ K, a ⬝ᵥ x ≤ c) ∧
    (ℓ ∩ K).Nonempty

/-- The hexagon `{x | a_j · x ≤ 1 for all j}` bounded by the lines `{x | a_j · x = 1}`. -/
def hexagon (a : ZMod 6 → Fin 2 → ℝ) : Set (Fin 2 → ℝ) := {x | ∀ j, a j ⬝ᵥ x ≤ 1}

/-- The conclusion of Mahler's theorem for the tac-lines `ℓ_j = {x | a_j · x = 1}` at the points
`P_j`: the lines are symmetric (`a_{j+3} = -a_j`) tac-lines of `K` through `P_j`, and the only
tac-lines of `K` at `P_j` (Mahler's (i): "there are unique tac-lines … at these points"; his
footnote 7: they are tangents of the boundary), no two coincide,
the hexagon `H` they bound has area `4Δ(K)`, each side of `H` is bisected at `P_j`, and `H` has
the least area among the hexagons bounded by six distinct symmetric tac-lines of `K`. -/
def IsMahlerHexagon (K : Set (Fin 2 → ℝ)) (P a : ZMod 6 → Fin 2 → ℝ) : Prop :=
  (∀ j, a (j + 3) = -a j) ∧
  (∀ j, IsTacLine K {x | a j ⬝ᵥ x = 1} ∧ a j ⬝ᵥ P j = 1) ∧
  (∀ j ℓ, IsTacLine K ℓ → P j ∈ ℓ → ℓ = {x | a j ⬝ᵥ x = 1}) ∧
  (∀ i j, i ≠ j → a i ≠ a j) ∧
  volume.real (hexagon a) = 4 * minimalDeterminant K ∧
  (∀ j, ∃ p q, hexagon a ∩ {x | a j ⬝ᵥ x = 1} = segment ℝ p q ∧ P j = midpoint ℝ p q) ∧
  ∀ b : ZMod 6 → Fin 2 → ℝ, (∀ j, b (j + 3) = -b j) → (∀ i j, i ≠ j → b i ≠ b j) →
    (∀ j, IsTacLine K {x | b j ⬝ᵥ x = 1}) → volume (hexagon a) ≤ volume (hexagon b)

/-! ## Proof -/

section Proof

private theorem mah_dot (a x : Fin 2 → ℝ) : a ⬝ᵥ x = a 0 * x 0 + a 1 * x 1 := by
  simp [dotProduct, Fin.sum_univ_two]

private theorem mah_ext {x y : Fin 2 → ℝ} (h0 : x 0 = y 0) (h1 : x 1 = y 1) : x = y := by
  funext i; fin_cases i <;> assumption

/-- Cauchy–Binet in the plane. -/
private theorem mah_cross_mul_cross (a c P Q : Fin 2 → ℝ) :
    cross a c * cross P Q = (a ⬝ᵥ P) * (c ⬝ᵥ Q) - (a ⬝ᵥ Q) * (c ⬝ᵥ P) := by
  simp only [cross, mah_dot]; ring

private theorem mah_eq_zero_of_dot {P Q v : Fin 2 → ℝ} (h : cross P Q ≠ 0) (hP : v ⬝ᵥ P = 0)
    (hQ : v ⬝ᵥ Q = 0) : v = 0 := by
  rw [mah_dot] at hP hQ
  simp only [cross] at h
  have h0 : v 0 = 0 := by
    have : v 0 * (P 0 * Q 1 - P 1 * Q 0) = 0 := by linear_combination Q 1 * hP - P 1 * hQ
    exact (mul_eq_zero.1 this).resolve_right h
  have h1 : v 1 = 0 := by
    have : v 1 * (P 0 * Q 1 - P 1 * Q 0) = 0 := by linear_combination P 0 * hQ - Q 0 * hP
    exact (mul_eq_zero.1 this).resolve_right h
  exact mah_ext (by simp [h0]) (by simp [h1])

private theorem mah_eq_of_dot {P Q a b : Fin 2 → ℝ} (h : cross P Q ≠ 0) (hP : a ⬝ᵥ P = b ⬝ᵥ P)
    (hQ : a ⬝ᵥ Q = b ⬝ᵥ Q) : a = b := by
  have := mah_eq_zero_of_dot h (v := a - b) (by rw [sub_dotProduct, hP, sub_self])
    (by rw [sub_dotProduct, hQ, sub_self])
  exact sub_eq_zero.1 this

private theorem mah_eq_of_dot' {c d x y : Fin 2 → ℝ} (h : cross c d ≠ 0) (hc : c ⬝ᵥ x = c ⬝ᵥ y)
    (hd : d ⬝ᵥ x = d ⬝ᵥ y) : x = y := by
  rw [dotProduct_comm c x, dotProduct_comm c y] at hc
  rw [dotProduct_comm d x, dotProduct_comm d y] at hd
  exact mah_eq_of_dot h hc hd

private theorem mah_decomp {P Q : Fin 2 → ℝ} (h : cross P Q ≠ 0) (x : Fin 2 → ℝ) :
    x = (cross x Q / cross P Q) • P + (cross P x / cross P Q) • Q := by
  apply mah_ext <;> simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] <;> field_simp <;>
    simp only [cross] <;> ring

/-- If `cross b a = 0` then `a` and `b` are proportional. -/
private theorem mah_smul_of_cross_eq_zero {a b : Fin 2 → ℝ} (h : cross b a = 0) (z : Fin 2 → ℝ) :
    (b ⬝ᵥ z) • a = (a ⬝ᵥ z) • b := by
  simp only [cross] at h
  apply mah_ext <;> simp
  · linear_combination (-z 1) * h
  · linear_combination z 0 * h

/-- The dual basis `e, f` of `c₀, c₂`. -/
private noncomputable def mah_e (c0 c2 : Fin 2 → ℝ) : Fin 2 → ℝ :=
  ![c2 1 / cross c0 c2, -c2 0 / cross c0 c2]

private noncomputable def mah_f (c0 c2 : Fin 2 → ℝ) : Fin 2 → ℝ :=
  ![-c0 1 / cross c0 c2, c0 0 / cross c0 c2]

private theorem mah_dual {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0) :
    c0 ⬝ᵥ mah_e c0 c2 = 1 ∧ c2 ⬝ᵥ mah_e c0 c2 = 0 ∧ c0 ⬝ᵥ mah_f c0 c2 = 0 ∧
      c2 ⬝ᵥ mah_f c0 c2 = 1 := by
  simp only [mah_e, mah_f, mah_dot, Matrix.cons_val_zero, Matrix.cons_val_one]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> field_simp <;> simp only [cross] <;> ring

private theorem mah_recon {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0) (x : Fin 2 → ℝ) :
    x = (c0 ⬝ᵥ x) • mah_e c0 c2 + (c2 ⬝ᵥ x) • mah_f c0 c2 := by
  apply mah_ext <;>
  simp only [mah_e, mah_f, mah_dot, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    Matrix.cons_val_zero, Matrix.cons_val_one] <;> field_simp <;> simp only [cross] <;> ring

private theorem mah_cross_e_f {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0) :
    cross (mah_e c0 c2) (mah_f c0 c2) = (cross c0 c2)⁻¹ := by
  rw [cross]
  simp only [mah_e, mah_f, Matrix.cons_val_zero, Matrix.cons_val_one]
  field_simp
  simp only [cross]
  ring

private theorem mah_dot_self_pos {b : Fin 2 → ℝ} (hb : b ≠ 0) : 0 < b ⬝ᵥ b := by
  rw [mah_dot]
  by_contra hc
  apply hb
  have h0 : b 0 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1)]
  have h1 : b 1 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1)]
  exact mah_ext (by simp [h0]) (by simp [h1])

private theorem mah_vec (f : (Fin 2 → ℝ) →L[ℝ] ℝ) : ∃ v : Fin 2 → ℝ, ∀ x, v ⬝ᵥ x = f x := by
  refine ⟨fun i => f (Pi.single i 1), fun x => ?_⟩
  have hx : x = x 0 • (Pi.single 0 1 : Fin 2 → ℝ) + x 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
    apply mah_ext <;> simp
  rw [mah_dot]
  conv_rhs => rw [hx]
  simp only [map_add, map_smul, smul_eq_mul]
  ring

/-! Convexity facts. -/

variable {K : Set (Fin 2 → ℝ)}

private theorem mah_neg_mem_interior (hK : IsSymmetricConvexDomain K) {z : Fin 2 → ℝ}
    (hz : z ∈ interior K) : -z ∈ interior K := by
  have hKn : (Homeomorph.neg (Fin 2 → ℝ)) ⁻¹' K = K := by
    ext x
    simp only [mem_preimage, Homeomorph.coe_neg]
    exact ⟨fun h => by simpa using hK.2.2.2 _ h, fun h => hK.2.2.2 _ h⟩
  have := (Homeomorph.neg (Fin 2 → ℝ)).preimage_interior K
  rw [hKn] at this
  rw [← this]
  simpa using hz

private theorem mah_zero_mem_interior (hK : IsSymmetricConvexDomain K) :
    (0 : Fin 2 → ℝ) ∈ interior K := by
  obtain ⟨z, hz⟩ := hK.2.2.1
  have h := (hK.1.interior) hz (mah_neg_mem_interior hK hz) (by norm_num : (0:ℝ) ≤ 1/2)
    (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num)
  simpa [← smul_add] using h

private theorem mah_frontier_mem (hK : IsSymmetricConvexDomain K) {x : Fin 2 → ℝ}
    (hx : x ∈ frontier K) : x ∈ K :=
  hK.2.1.isClosed.frontier_subset hx

private theorem mah_neg_frontier (hK : IsSymmetricConvexDomain K) {x : Fin 2 → ℝ}
    (hx : x ∈ frontier K) : -x ∈ frontier K := by
  refine ⟨subset_closure (hK.2.2.2 _ (mah_frontier_mem hK hx)), fun h => hx.2 ?_⟩
  simpa using mah_neg_mem_interior hK h

private theorem mah_combo_interior (hK : IsSymmetricConvexDomain K) {u v : Fin 2 → ℝ} (hu : u ∈ K)
    (hv : v ∈ K) {σ τ : ℝ} (hσ : 0 ≤ σ) (hτ : 0 ≤ τ) (h : σ + τ < 1) :
    σ • u + τ • v ∈ interior K := by
  rcases eq_or_lt_of_le (add_nonneg hσ hτ) with hs | hs
  · have h1 : σ = 0 := by linarith
    have h2 : τ = 0 := by linarith
    subst h1; subst h2; simpa using mah_zero_mem_interior hK
  · have hz : (σ / (σ + τ)) • u + (τ / (σ + τ)) • v ∈ K :=
      hK.1 hu hv (div_nonneg hσ hs.le) (div_nonneg hτ hs.le) (by field_simp)
    have := hK.1.combo_interior_self_mem_interior (mah_zero_mem_interior hK) hz
      (by linarith : (0:ℝ) < 1 - (σ + τ)) hs.le (by ring)
    convert this using 1
    simp only [smul_zero, zero_add, smul_add, smul_smul]
    congr 1 <;> congr 1 <;> field_simp

private theorem mah_smul_frontier_nonneg (hK : IsSymmetricConvexDomain K) {x : Fin 2 → ℝ} {t : ℝ}
    (hx : x ∈ frontier K) (ht0 : 0 ≤ t) (ht : t • x ∈ frontier K) : t = 1 := by
  rcases lt_trichotomy t 1 with h | h | h
  · exfalso; apply ht.2
    simpa using mah_combo_interior hK (mah_frontier_mem hK hx) (mah_frontier_mem hK hx) ht0
      le_rfl (by linarith : t + 0 < 1)
  · exact h
  · exfalso; apply hx.2
    have := mah_combo_interior hK (mah_frontier_mem hK ht) (mah_frontier_mem hK ht)
      (by positivity : (0:ℝ) ≤ t⁻¹) le_rfl (by rw [add_zero]; exact inv_lt_one_of_one_lt₀ h)
    simpa [smul_smul, inv_mul_cancel₀ (by linarith : t ≠ 0)] using this

private theorem mah_smul_frontier (hK : IsSymmetricConvexDomain K) {x : Fin 2 → ℝ} {t : ℝ}
    (hx : x ∈ frontier K) (ht : t • x ∈ frontier K) : t = 1 ∨ t = -1 := by
  rcases le_or_gt 0 t with h | h
  · exact Or.inl (mah_smul_frontier_nonneg hK hx h ht)
  · right
    have := mah_smul_frontier_nonneg hK (mah_neg_frontier hK hx) (by linarith : (0:ℝ) ≤ -t)
      (by simpa using ht)
    linarith

private theorem mah_supporting (hK : IsSymmetricConvexDomain K) {P : Fin 2 → ℝ}
    (hP : P ∈ frontier K) :
    ∃ a : Fin 2 → ℝ, a ⬝ᵥ P = 1 ∧ ∀ y ∈ K, a ⬝ᵥ y ≤ 1 := by
  obtain ⟨f, hf⟩ := geometric_hahn_banach_open_point hK.1.interior isOpen_interior hP.2
  have hf0 : 0 < f P := by simpa using hf 0 (mah_zero_mem_interior hK)
  have hcl : ∀ y ∈ K, f y ≤ f P := by
    intro y hy
    have : y ∈ closure (interior K) := by
      rw [hK.1.closure_interior_eq_closure_of_nonempty_interior hK.2.2.1]
      exact subset_closure hy
    exact closure_minimal (fun z hz => (hf z hz).le)
      (isClosed_le f.continuous continuous_const) this
  obtain ⟨v, hv⟩ := mah_vec f
  refine ⟨(f P)⁻¹ • v, ?_, fun y hy => ?_⟩
  · rw [smul_dotProduct, hv, smul_eq_mul, inv_mul_cancel₀ hf0.ne']
  · rw [smul_dotProduct, hv, smul_eq_mul, inv_mul_le_iff₀ hf0, mul_one]; exact hcl y hy

private theorem mah_separate (hK : IsSymmetricConvexDomain K) {y : Fin 2 → ℝ} (hy : y ∉ K) :
    ∃ d : Fin 2 → ℝ, (∀ x ∈ K, d ⬝ᵥ x < 1) ∧ 1 < d ⬝ᵥ y := by
  obtain ⟨f, u, hfK, hfy⟩ := geometric_hahn_banach_closed_point hK.1 hK.2.1.isClosed hy
  have hu : 0 < u := by simpa using hfK 0 (interior_subset (mah_zero_mem_interior hK))
  obtain ⟨v, hv⟩ := mah_vec f
  refine ⟨u⁻¹ • v, fun x hx => ?_, ?_⟩
  · rw [smul_dotProduct, hv, smul_eq_mul, inv_mul_lt_iff₀ hu, mul_one]; exact hfK x hx
  · rw [smul_dotProduct, hv, smul_eq_mul, lt_inv_mul_iff₀ hu, mul_one]; exact hfy

private theorem mah_lt_of_interior {S : Set (Fin 2 → ℝ)} {b x : Fin 2 → ℝ} {γ : ℝ} (hb : b ≠ 0)
    (hS : ∀ y ∈ S, b ⬝ᵥ y ≤ γ) (hx : x ∈ interior S) : b ⬝ᵥ x < γ := by
  have hc : Continuous (fun t : ℝ => x + t • b) := by fun_prop
  have h2 : (fun t : ℝ => x + t • b) ⁻¹' interior S ∈ nhds (0:ℝ) :=
    hc.continuousAt.preimage_mem_nhds (by simpa using isOpen_interior.mem_nhds hx)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 h2
  have hmem : x + (ε / 2) • b ∈ S := by
    apply interior_subset
    apply hball
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos (by linarith)]
    linarith
  have h3 := hS _ hmem
  rw [dotProduct_add, dotProduct_smul, smul_eq_mul] at h3
  have hbb := mah_dot_self_pos hb
  nlinarith

private theorem mah_abs_lt_of_interior {S : Set (Fin 2 → ℝ)} {b x : Fin 2 → ℝ} (hb : b ≠ 0)
    (hS : ∀ y ∈ S, |b ⬝ᵥ y| ≤ 1) (hx : x ∈ interior S) : |b ⬝ᵥ x| < 1 := by
  have h1 := mah_lt_of_interior (γ := 1) hb (fun y hy => (abs_le.1 (hS y hy)).2) hx
  have h2 := mah_lt_of_interior (γ := 1) (neg_ne_zero.2 hb)
    (fun y hy => by rw [neg_dotProduct]; linarith [(abs_le.1 (hS y hy)).1]) hx
  rw [neg_dotProduct] at h2
  exact abs_lt.2 ⟨by linarith, h1⟩


private theorem mah_lattice (u v : Fin 2 → ℝ) (h : cross u v ≠ 0) :
    IsLattice (Submodule.span ℤ {u, v}) ∧
      MinkowskiMahler.det (Submodule.span ℤ {u, v}) = |cross u v| := by
  have hli : LinearIndependent ℝ ![u, v] := by
    rw [LinearIndependent.pair_iff]
    intro s t hst
    have h0 := congrFun hst 0
    have h1 := congrFun hst 1
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h0 h1
    simp only [cross] at h
    constructor
    · have : s * (u 0 * v 1 - u 1 * v 0) = 0 := by linear_combination v 1 * h0 - v 0 * h1
      exact (mul_eq_zero.1 this).resolve_right h
    · have : t * (u 0 * v 1 - u 1 * v 0) = 0 := by linear_combination u 0 * h1 - u 1 * h0
      exact (mul_eq_zero.1 this).resolve_right h
  let b := basisOfLinearIndependentOfCardEqFinrank hli (by simp)
  have hb : ⇑b = ![u, v] := coe_basisOfLinearIndependentOfCardEqFinrank _ _
  have hrange : Set.range b = {u, v} := by
    rw [hb]; ext x; simp [eq_comm, or_comm]
  rw [← hrange]
  refine ⟨⟨inferInstance, ZSpan.span_top b⟩, ?_⟩
  unfold MinkowskiMahler.det
  rw [ZLattice.covolume_eq_det _ (b.restrictScalars ℤ)]
  congr 1
  rw [Matrix.det_fin_two]
  simp [Module.Basis.restrictScalars_apply, hb, cross]

private theorem mah_minDet_le {K : Set (Fin 2 → ℝ)} {u v : Fin 2 → ℝ} (h : cross u v ≠ 0)
    (hadm : ∀ x ∈ Submodule.span ℤ {u, v}, x ∈ interior K → x = 0) :
    minimalDeterminant K ≤ |cross u v| := by
  obtain ⟨hL, hdet⟩ := mah_lattice u v h
  unfold minimalDeterminant
  apply csInf_le
  · refine ⟨0, ?_⟩
    rintro d ⟨Λ, -, -, rfl⟩
    exact ENNReal.toReal_nonneg
  · exact ⟨_, hL, hadm, hdet⟩

private theorem mah_minDet_nonneg (K : Set (Fin 2 → ℝ)) : 0 ≤ minimalDeterminant K := by
  unfold minimalDeterminant
  apply Real.sInf_nonneg
  rintro d ⟨Λ, -, -, rfl⟩
  exact ENNReal.toReal_nonneg



private theorem mah_vol_affine (a b c d p q : ℝ) (h : a * d - b * c ≠ 0) (s : Set (Fin 2 → ℝ)) :
    volume ((fun y : Fin 2 → ℝ => ![a * y 0 + b * y 1 + p, c * y 0 + d * y 1 + q]) ⁻¹' s) =
      ENNReal.ofReal |(a * d - b * c)⁻¹| * volume s := by
  have hfun : (fun y : Fin 2 → ℝ => ![a * y 0 + b * y 1 + p, c * y 0 + d * y 1 + q]) =
      (fun z => z + ![p, q]) ∘ (Matrix.toLin' !![a, b; c, d]) := by
    funext y; apply mah_ext <;> simp [dotProduct, Fin.sum_univ_two]
  have hdet : LinearMap.det (Matrix.toLin' !![a, b; c, d]) = a * d - b * c := by
    rw [LinearMap.det_toLin', Matrix.det_fin_two_of]
  rw [hfun, Set.preimage_comp, Measure.addHaar_preimage_linearMap _ (by rw [hdet]; exact h),
    measure_preimage_add_right, hdet]

/-- The half-open unit triangle. -/
private def mah_T : Set (Fin 2 → ℝ) := {y | 0 ≤ y 0 ∧ 0 ≤ y 1 ∧ y 0 + y 1 < 1}

private theorem mah_vol_T : volume mah_T = ENNReal.ofReal (1 / 2) := by
  set Q : Set (Fin 2 → ℝ) := Set.Icc 0 1
  set R : Set (Fin 2 → ℝ) := {y | y 0 ≤ 1 ∧ y 1 ≤ 1 ∧ 1 < y 0 + y 1}
  set L : Set (Fin 2 → ℝ) := {y | y 0 + y 1 = 1}
  have hQ : volume Q = 1 := by simp [Q, Real.volume_Icc_pi]
  have hR : R = (fun y : Fin 2 → ℝ => ![(-1) * y 0 + 0 * y 1 + 1, 0 * y 0 + (-1) * y 1 + 1]) ⁻¹'
      mah_T := by
    ext y
    simp only [R, mah_T, mem_ofPred_eq, mem_preimage, Matrix.cons_val_zero, Matrix.cons_val_one]
    constructor <;> rintro ⟨h1, h2, h3⟩ <;> refine ⟨?_, ?_, ?_⟩ <;> linarith
  have hvR : volume R = volume mah_T := by
    rw [hR, mah_vol_affine _ _ _ _ _ _ (by norm_num)]; norm_num
  have hRm : MeasurableSet R := by
    simp only [R, ofPred_and]
    exact (measurableSet_le (by fun_prop) measurable_const).inter
      ((measurableSet_le (by fun_prop) measurable_const).inter
        (measurableSet_lt measurable_const (by fun_prop)))
  have hdisj : Disjoint mah_T R := by
    rw [Set.disjoint_left]; rintro y ⟨-, -, h1⟩ ⟨-, -, h2⟩; linarith
  have hsub : mah_T ∪ R ⊆ Q := by
    rintro y (⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩) <;>
      simp only [Q, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two, Pi.zero_apply, Pi.one_apply] <;>
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith
  have hcov : Q ⊆ mah_T ∪ R ∪ L := by
    intro y hy
    simp only [Q, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two, Pi.zero_apply,
      Pi.one_apply] at hy
    rcases lt_trichotomy (y 0 + y 1) 1 with h | h | h
    · exact Or.inl (Or.inl ⟨hy.1.1, hy.1.2, h⟩)
    · exact Or.inr h
    · exact Or.inl (Or.inr ⟨hy.2.1, hy.2.2, h⟩)
  have hL : volume L = 0 := by
    let ℓ : (Fin 2 → ℝ) →ₗ[ℝ] ℝ :=
      (LinearMap.proj 0 : (Fin 2 → ℝ) →ₗ[ℝ] ℝ) + (LinearMap.proj 1 : (Fin 2 → ℝ) →ₗ[ℝ] ℝ)
    have hLe : L = (AffineSubspace.mk' (![1, 0] : Fin 2 → ℝ) (LinearMap.ker ℓ) :
        Set (Fin 2 → ℝ)) := by
      ext y
      simp only [L, mem_ofPred_eq, SetLike.mem_coe, AffineSubspace.mem_mk', LinearMap.mem_ker,
        vsub_eq_sub, ℓ, LinearMap.add_apply, LinearMap.coe_proj, Function.eval, Pi.sub_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one]
      constructor <;> intro h <;> linarith
    rw [hLe]
    apply Measure.addHaar_affineSubspace
    intro htop
    have h0 : (0 : Fin 2 → ℝ) ∈ (AffineSubspace.mk' (![1, 0] : Fin 2 → ℝ) (LinearMap.ker ℓ)) := by
      rw [htop]; exact AffineSubspace.mem_top _ _ _
    simp [AffineSubspace.mem_mk', ℓ] at h0
  have h1 : volume mah_T + volume R ≤ 1 := by
    rw [← measure_union hdisj hRm, ← hQ]; exact measure_mono hsub
  have h2 : 1 ≤ volume mah_T + volume R := by
    calc (1 : ENNReal) = volume Q := hQ.symm
    _ ≤ volume (mah_T ∪ R ∪ L) := measure_mono hcov
    _ ≤ volume (mah_T ∪ R) + volume L := measure_union_le _ _
    _ = volume mah_T + volume R := by rw [hL, add_zero, measure_union hdisj hRm]
  have h3 : volume mah_T + volume mah_T = 1 := by
    rw [hvR] at h1 h2; exact le_antisymm h1 h2
  rw [ENNReal.ofReal_div_of_pos (by norm_num), ENNReal.ofReal_one, ENNReal.ofReal_ofNat,
    ENNReal.eq_div_iff (by norm_num) (by norm_num), two_mul, h3]


private theorem mah_div_nonneg_iff {A κ : ℝ} (hκ : 0 < κ) : 0 ≤ A / κ ↔ 0 ≤ A := by
  rw [le_div_iff₀ hκ, zero_mul]

/-- The square `|y₀| ≤ 1, |y₁| ≤ 1`. -/
private def mah_S : Set (Fin 2 → ℝ) := {y | |y 0| ≤ 1 ∧ |y 1| ≤ 1}

private theorem mah_vol_S : volume mah_S = ENNReal.ofReal 4 := by
  have : mah_S = Set.Icc (-1) 1 := by
    ext y
    simp only [mah_S, mem_ofPred_eq, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two, abs_le,
      Pi.neg_apply, Pi.one_apply]
    tauto
  rw [this, Real.volume_Icc_pi, Fin.prod_univ_two, ← ENNReal.ofReal_mul (by norm_num)]
  norm_num

/-- The corner `y₀ ≤ 1, y₁ ≤ 1, l y₀ + m y₁ > 1` of the square cut off by a line. -/
private def mah_Cp (l m : ℝ) : Set (Fin 2 → ℝ) := {y | y 0 ≤ 1 ∧ y 1 ≤ 1 ∧ 1 < l * y 0 + m * y 1}

/-- The opposite corner. -/
private def mah_Cm (l m : ℝ) : Set (Fin 2 → ℝ) := {y | -1 ≤ y 0 ∧ -1 ≤ y 1 ∧ l * y 0 + m * y 1 < -1}

private theorem mah_measurable_Cp (l m : ℝ) : MeasurableSet (mah_Cp l m) := by
  simp only [mah_Cp, ofPred_and]
  exact (measurableSet_le (by fun_prop) measurable_const).inter
    ((measurableSet_le (by fun_prop) measurable_const).inter
      (measurableSet_lt measurable_const (by fun_prop)))

private theorem mah_measurable_Cm (l m : ℝ) : MeasurableSet (mah_Cm l m) := by
  simp only [mah_Cm, ofPred_and]
  exact (measurableSet_le measurable_const (by fun_prop)).inter
    ((measurableSet_le measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const))

private theorem mah_vol_corner_aux {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (hκ : 0 < l + m - 1) :
    ENNReal.ofReal |((l / (l + m - 1)) * (m / (l + m - 1)) - 0 * 0)⁻¹| *
      ENNReal.ofReal (1 / 2) = ENNReal.ofReal ((l + m - 1) ^ 2 / (l * m) / 2) := by
  rw [← ENNReal.ofReal_mul (abs_nonneg _)]
  congr 1
  rw [mul_zero, sub_zero, abs_of_pos (by positivity)]
  field_simp

private theorem mah_vol_Cp {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (hκ : 0 < l + m - 1) :
    volume (mah_Cp l m) = ENNReal.ofReal ((l + m - 1) ^ 2 / (l * m) / 2) := by
  set κ := l + m - 1 with hκdef
  have hset : mah_Cp l m = (fun y : Fin 2 → ℝ =>
      ![(-l / κ) * y 0 + 0 * y 1 + l / κ, 0 * y 0 + (-m / κ) * y 1 + m / κ]) ⁻¹' mah_T := by
    ext y
    simp only [mah_Cp, mah_T, mem_ofPred_eq, mem_preimage, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    have e0 : (-l / κ) * y 0 + 0 * y 1 + l / κ = l * (1 - y 0) / κ := by ring
    have e1 : 0 * y 0 + (-m / κ) * y 1 + m / κ = m * (1 - y 1) / κ := by ring
    rw [e0, e1, mah_div_nonneg_iff hκ, mah_div_nonneg_iff hκ, ← add_div, div_lt_one hκ,
      mul_nonneg_iff_of_pos_left hl, mul_nonneg_iff_of_pos_left hm]
    constructor
    · rintro ⟨h1, h2, h3⟩; refine ⟨?_, ?_, ?_⟩ <;> linarith
    · rintro ⟨h1, h2, h3⟩; refine ⟨?_, ?_, ?_⟩ <;> linarith
  rw [hset, mah_vol_affine _ _ _ _ _ _ (by
    have : 0 < (-l / κ) * (-m / κ) := by
      rw [neg_div, neg_div, neg_mul_neg]; positivity
    linarith), mah_vol_T]
  rw [show (-l / κ) * (-m / κ) - 0 * 0 = (l / κ) * (m / κ) - 0 * 0 by ring]
  exact mah_vol_corner_aux hl hm hκ

private theorem mah_vol_Cm {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (hκ : 0 < l + m - 1) :
    volume (mah_Cm l m) = ENNReal.ofReal ((l + m - 1) ^ 2 / (l * m) / 2) := by
  set κ := l + m - 1 with hκdef
  have hset : mah_Cm l m = (fun y : Fin 2 → ℝ =>
      ![(l / κ) * y 0 + 0 * y 1 + l / κ, 0 * y 0 + (m / κ) * y 1 + m / κ]) ⁻¹' mah_T := by
    ext y
    simp only [mah_Cm, mah_T, mem_ofPred_eq, mem_preimage, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    have e0 : (l / κ) * y 0 + 0 * y 1 + l / κ = l * (1 + y 0) / κ := by ring
    have e1 : 0 * y 0 + (m / κ) * y 1 + m / κ = m * (1 + y 1) / κ := by ring
    rw [e0, e1, mah_div_nonneg_iff hκ, mah_div_nonneg_iff hκ, ← add_div, div_lt_one hκ,
      mul_nonneg_iff_of_pos_left hl, mul_nonneg_iff_of_pos_left hm]
    constructor
    · rintro ⟨h1, h2, h3⟩; refine ⟨?_, ?_, ?_⟩ <;> linarith
    · rintro ⟨h1, h2, h3⟩; refine ⟨?_, ?_, ?_⟩ <;> linarith
  rw [hset, mah_vol_affine _ _ _ _ _ _ (by
    have : 0 < (l / κ) * (m / κ) := by positivity
    linarith), mah_vol_T]
  exact mah_vol_corner_aux hl hm hκ

/-- The normalized hexagon `|y₀| ≤ 1, |l y₀ + m y₁| ≤ 1, |y₁| ≤ 1`. -/
private def mah_Hn (l m : ℝ) : Set (Fin 2 → ℝ) :=
  {y | |y 0| ≤ 1 ∧ |l * y 0 + m * y 1| ≤ 1 ∧ |y 1| ≤ 1}

private theorem mah_vol_Hn {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (h1 : 1 < l + m) (h2 : l - m < 1)
    (h3 : m - l < 1) :
    volume (mah_Hn l m) = ENNReal.ofReal (4 - (l + m - 1) ^ 2 / (l * m)) := by
  have hκ : 0 < l + m - 1 := by linarith
  have hsub : mah_Cp l m ∪ mah_Cm l m ⊆ mah_S := by
    rintro y (⟨ha, hb, hc⟩ | ⟨ha, hb, hc⟩)
    · have hy1 : m * y 1 ≤ m * 1 := mul_le_mul_of_nonneg_left hb hm.le
      have hy0 : l * y 0 ≤ l * 1 := mul_le_mul_of_nonneg_left ha hl.le
      have h0' : 0 < l * (y 0 + 1) := by nlinarith
      have h1' : 0 < m * (y 1 + 1) := by nlinarith
      have := (mul_pos_iff_of_pos_left hl).1 h0'
      have := (mul_pos_iff_of_pos_left hm).1 h1'
      exact ⟨abs_le.2 ⟨by linarith, ha⟩, abs_le.2 ⟨by linarith, hb⟩⟩
    · have hy1 : m * (-1) ≤ m * y 1 := mul_le_mul_of_nonneg_left hb hm.le
      have hy0 : l * (-1) ≤ l * y 0 := mul_le_mul_of_nonneg_left ha hl.le
      have h0' : 0 < l * (1 - y 0) := by nlinarith
      have h1' : 0 < m * (1 - y 1) := by nlinarith
      have := (mul_pos_iff_of_pos_left hl).1 h0'
      have := (mul_pos_iff_of_pos_left hm).1 h1'
      exact ⟨abs_le.2 ⟨ha, by linarith⟩, abs_le.2 ⟨hb, by linarith⟩⟩
  have hset : mah_Hn l m = mah_S \ (mah_Cp l m ∪ mah_Cm l m) := by
    ext y
    simp only [mah_Hn, mah_S, mah_Cp, mah_Cm, mem_ofPred_eq, mem_sdiff, mem_union, abs_le]
    constructor
    · rintro ⟨ha, hb, hc⟩
      refine ⟨⟨ha, hc⟩, ?_⟩
      rintro (⟨-, -, h⟩ | ⟨-, -, h⟩) <;> linarith
    · rintro ⟨⟨ha, hc⟩, hn⟩
      refine ⟨ha, ⟨?_, ?_⟩, hc⟩
      · by_contra h; exact hn (Or.inr ⟨ha.1, hc.1, by linarith⟩)
      · by_contra h; exact hn (Or.inl ⟨ha.2, hc.2, by linarith⟩)
  have hdisj : Disjoint (mah_Cp l m) (mah_Cm l m) := by
    rw [Set.disjoint_left]; rintro y ⟨-, -, h1⟩ ⟨-, -, h2⟩; linarith
  have hX : 0 ≤ (l + m - 1) ^ 2 / (l * m) / 2 := by positivity
  rw [hset, measure_sdiff hsub
    ((mah_measurable_Cp l m).union (mah_measurable_Cm l m)).nullMeasurableSet
    (by rw [measure_union hdisj (mah_measurable_Cm l m), mah_vol_Cp hl hm hκ, mah_vol_Cm hl hm hκ]
        exact ENNReal.add_ne_top.2 ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩),
    measure_union hdisj (mah_measurable_Cm l m), mah_vol_Cp hl hm hκ, mah_vol_Cm hl hm hκ,
    mah_vol_S, ← ENNReal.ofReal_add hX hX, ← ENNReal.ofReal_sub _ (by positivity)]
  congr 1
  ring


/-! Hexagons and parallelograms bounded by symmetric lines. -/

/-- The hexagon `|b₀ · x| ≤ 1, |b₁ · x| ≤ 1, |b₂ · x| ≤ 1`. -/
private def mah_H (b0 b1 b2 : Fin 2 → ℝ) : Set (Fin 2 → ℝ) :=
  {x | |b0 ⬝ᵥ x| ≤ 1 ∧ |b1 ⬝ᵥ x| ≤ 1 ∧ |b2 ⬝ᵥ x| ≤ 1}

/-- The parallelogram `|e · x| ≤ 1, |f · x| ≤ 1`. -/
private def mah_P (e f : Fin 2 → ℝ) : Set (Fin 2 → ℝ) := {x | |e ⬝ᵥ x| ≤ 1 ∧ |f ⬝ᵥ x| ≤ 1}

private theorem mah_ne_zero_left {e f : Fin 2 → ℝ} (h : cross e f ≠ 0) : e ≠ 0 := by
  rintro rfl; simp [cross] at h

private theorem mah_ne_zero_right {e f : Fin 2 → ℝ} (h : cross e f ≠ 0) : f ≠ 0 := by
  rintro rfl; simp [cross] at h

private theorem mah_vol_P {e f : Fin 2 → ℝ} (h : cross e f ≠ 0) :
    volume (mah_P e f) = ENNReal.ofReal (4 / |cross e f|) := by
  have hset : mah_P e f = (fun y : Fin 2 → ℝ =>
      ![e 0 * y 0 + e 1 * y 1 + 0, f 0 * y 0 + f 1 * y 1 + 0]) ⁻¹' mah_S := by
    ext x; simp [mah_P, mah_S]
  rw [hset, mah_vol_affine _ _ _ _ _ _ h, mah_vol_S, ← ENNReal.ofReal_mul (abs_nonneg _)]
  congr 1
  rw [abs_inv]; simp only [cross]; ring

private theorem mah_dot_comb (l m : ℝ) (c0 c2 x : Fin 2 → ℝ) :
    (l • c0 + m • c2) ⬝ᵥ x = l * (c0 ⬝ᵥ x) + m * (c2 ⬝ᵥ x) := by
  simp [add_dotProduct, smul_dotProduct]

private theorem mah_vol_H {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0) {l m : ℝ} (hl : 0 < l)
    (hm : 0 < m) (h1 : 1 < l + m) (h2 : l - m < 1) (h3 : m - l < 1) :
    volume (mah_H c0 (l • c0 + m • c2) c2) =
      ENNReal.ofReal ((4 - (l + m - 1) ^ 2 / (l * m)) / |cross c0 c2|) := by
  have hset : mah_H c0 (l • c0 + m • c2) c2 = (fun y : Fin 2 → ℝ =>
      ![c0 0 * y 0 + c0 1 * y 1 + 0, c2 0 * y 0 + c2 1 * y 1 + 0]) ⁻¹' mah_Hn l m := by
    ext x; simp [mah_H, mah_Hn]
  rw [hset, mah_vol_affine _ _ _ _ _ _ h, mah_vol_Hn hl hm h1 h2 h3,
    ← ENNReal.ofReal_mul (abs_nonneg _)]
  congr 1
  rw [abs_inv]; simp only [cross]; ring

/-- Elements of the lattice generated by `u, v` as real combinations. -/
private theorem mah_mem_span_pair {u v y : Fin 2 → ℝ} (hy : y ∈ Submodule.span ℤ {u, v}) :
    ∃ m n : ℤ, y = (m : ℝ) • u + (n : ℝ) • v := by
  obtain ⟨m, n, h⟩ := Submodule.mem_span_pair.1 hy
  exact ⟨m, n, by rw [← h, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]⟩

private theorem mah_int_eq_zero {m : ℤ} (h : |(m : ℝ)| < 1) : m = 0 := by
  have : |m| < 1 := by exact_mod_cast h
  exact Int.abs_lt_one_iff.1 this

/-- **Lemma 4 (the part used).** A symmetric convex domain inside the parallelogram
`|e · x| ≤ 1, |f · x| ≤ 1` has `Δ(K) ≤ ¼ V`: the lattice generated by the midpoints of two
adjacent sides is admissible. -/
private theorem mah_par_lower {K : Set (Fin 2 → ℝ)} {e f : Fin 2 → ℝ} (h : cross e f ≠ 0)
    (hK : K ⊆ mah_P e f) : 4 * minimalDeterminant K ≤ 4 / |cross e f| := by
  obtain ⟨he1, he0, hf0, hf1⟩ := mah_dual h
  have hc : cross (mah_e e f) (mah_f e f) ≠ 0 := by
    rw [mah_cross_e_f h]; exact inv_ne_zero h
  have hle := mah_minDet_le (K := K) hc (by
    intro y hy hyK
    obtain ⟨m, n, rfl⟩ := mah_mem_span_pair hy
    have hyP := interior_mono hK hyK
    have h1 := mah_abs_lt_of_interior (S := mah_P e f) (mah_ne_zero_left h)
      (fun z hz => hz.1) hyP
    have h2 := mah_abs_lt_of_interior (S := mah_P e f) (mah_ne_zero_right h)
      (fun z hz => hz.2) hyP
    simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, he1, he0, hf0, hf1, mul_one,
      mul_zero, add_zero, zero_add] at h1 h2
    rw [mah_int_eq_zero h1, mah_int_eq_zero h2]; simp)
  rw [mah_cross_e_f h, abs_inv] at hle
  rw [div_eq_mul_inv]
  linarith

/-- **Lemma 1 (Mahler).** If `M₀, M₁, M₂ = M₁ - M₀` lie on the lines `a_k · x = 1` of a hexagon
`|a_k · x| ≤ 1` (with the sign conditions of a convex hexagon), then every nonzero point of the
lattice generated by `M₀, M₁` lies outside the open hexagon. -/
private theorem mah_adm {a0 a1 a2 M0 M1 : Fin 2 → ℝ} (h00 : a0 ⬝ᵥ M0 = 1) (h11 : a1 ⬝ᵥ M1 = 1)
    (h22 : a2 ⬝ᵥ M1 - a2 ⬝ᵥ M0 = 1) (h01' : a0 ⬝ᵥ M1 ≤ 1)
    (h10 : 0 ≤ a1 ⬝ᵥ M0) (h21 : 0 ≤ a2 ⬝ᵥ M1)
    (m n : ℤ) (hmn : ¬ (m = 0 ∧ n = 0)) :
    1 ≤ |a0 ⬝ᵥ ((m : ℝ) • M0 + (n : ℝ) • M1)| ∨ 1 ≤ |a1 ⬝ᵥ ((m : ℝ) • M0 + (n : ℝ) • M1)| ∨
      1 ≤ |a2 ⬝ᵥ ((m : ℝ) • M0 + (n : ℝ) • M1)| := by
  simp only [dotProduct_add, dotProduct_smul, smul_eq_mul]
  set A0 := a0 ⬝ᵥ M0; set A1 := a1 ⬝ᵥ M0; set A2 := a2 ⬝ᵥ M0
  set B0 := a0 ⬝ᵥ M1; set B1 := a1 ⬝ᵥ M1; set B2 := a2 ⬝ᵥ M1
  rw [h00, h11]
  have hB2 : B2 = 1 + A2 := by linarith
  rcases lt_trichotomy n 0 with hn | hn | hn
  · have hn' : (n : ℝ) ≤ -1 := by exact_mod_cast (by omega : n ≤ -1)
    rcases le_or_gt m 0 with hm | hm
    · have hm' : (m : ℝ) ≤ 0 := by exact_mod_cast hm
      right; left; rw [le_abs]; right; nlinarith
    · have hm' : (1 : ℝ) ≤ m := by exact_mod_cast (by omega : 1 ≤ m)
      rcases le_or_gt (m + n) 0 with hmn' | hmn'
      · have h' : (m : ℝ) + n ≤ 0 := by exact_mod_cast hmn'
        right; right; rw [le_abs]; right; rw [hB2]; nlinarith
      · have h' : (1 : ℝ) ≤ m + n := by exact_mod_cast (by omega : 1 ≤ m + n)
        left; rw [le_abs]; left; nlinarith
  · subst hn
    have hm : m ≠ 0 := fun h => hmn ⟨h, rfl⟩
    left
    simp only [Int.cast_zero, zero_mul, add_zero, mul_one]
    have : (1 : ℤ) ≤ |m| := Int.one_le_abs hm
    exact_mod_cast this
  · have hn' : (1 : ℝ) ≤ n := by exact_mod_cast (by omega : 1 ≤ n)
    rcases le_or_gt 0 m with hm | hm
    · have hm' : (0 : ℝ) ≤ m := by exact_mod_cast hm
      right; left; rw [le_abs]; left; nlinarith
    · have hm' : (m : ℝ) ≤ -1 := by exact_mod_cast (by omega : m ≤ -1)
      rcases le_or_gt 0 (m + n) with hmn' | hmn'
      · have h' : (0 : ℝ) ≤ m + n := by exact_mod_cast hmn'
        right; right; rw [le_abs]; left; rw [hB2]; nlinarith
      · have h' : (m : ℝ) + n ≤ -1 := by exact_mod_cast (by omega : m + n ≤ -1)
        left; rw [le_abs]; right; nlinarith

/-- **Lemma 5 (the part used).** A symmetric convex domain inside the proper hexagon
`|c₀ · x| ≤ 1, |(l c₀ + m c₂) · x| ≤ 1, |c₂ · x| ≤ 1` has `4 Δ(K) ≤ V(H)`: the lattice generated
by the midpoints of the sides of `H` is `H`-admissible. -/
private theorem mah_hex_lower {K : Set (Fin 2 → ℝ)} {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0)
    {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (h1 : 1 < l + m) (h2 : l - m < 1) (h3 : m - l < 1)
    (hK : K ⊆ mah_H c0 (l • c0 + m • c2) c2) :
    4 * minimalDeterminant K ≤ (4 - (l + m - 1) ^ 2 / (l * m)) / |cross c0 c2| := by
  obtain ⟨he0, he2, hf0, hf2⟩ := mah_dual h
  set e := mah_e c0 c2
  set f := mah_f c0 c2
  set β := (1 - l - m) / (2 * m)
  set γ := (1 - l - m) / (2 * l)
  set M0 := e + β • f
  set M1 := (1 + γ) • e + (1 + β) • f
  have d00 : c0 ⬝ᵥ M0 = 1 := by simp [M0, dotProduct_add, dotProduct_smul, he0, hf0]
  have d01 : c0 ⬝ᵥ M1 = 1 + γ := by simp [M1, dotProduct_add, dotProduct_smul, he0, hf0]
  have d20 : c2 ⬝ᵥ M0 = β := by simp [M0, dotProduct_add, dotProduct_smul, he2, hf2]
  have d21 : c2 ⬝ᵥ M1 = 1 + β := by simp [M1, dotProduct_add, dotProduct_smul, he2, hf2]
  have d10 : (l • c0 + m • c2) ⬝ᵥ M0 = l + m * β := by rw [mah_dot_comb, d00, d20]; ring
  have d11 : (l • c0 + m • c2) ⬝ᵥ M1 = 1 := by
    rw [mah_dot_comb, d01, d21]; simp only [β, γ]; field_simp; ring
  have hβ : β ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
  have hγ : γ ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
  have hγ' : 0 ≤ 1 + γ := by
    have : 1 + γ = (1 + l - m) / (2 * l) := by simp only [γ]; field_simp; ring
    rw [this]; exact div_nonneg (by linarith) (by linarith)
  have hβ' : 0 ≤ 1 + β := by
    have : 1 + β = (1 - l + m) / (2 * m) := by simp only [β]; field_simp; ring
    rw [this]; exact div_nonneg (by linarith) (by linarith)
  have hmb : l + m * β = (1 + l - m) / 2 := by simp only [β]; field_simp; ring
  have hcross : cross M0 M1 = (1 - (l + m - 1) ^ 2 / (4 * l * m)) * (cross c0 c2)⁻¹ := by
    have hef := mah_cross_e_f h
    have : cross M0 M1 = (1 - β * γ) * cross e f := by
      simp only [M0, M1, cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
    rw [this, hef]
    congr 1
    simp only [β, γ]; field_simp; ring
  have hpos : 0 < 1 - (l + m - 1) ^ 2 / (4 * l * m) := by
    rw [sub_pos, div_lt_one (by positivity)]
    nlinarith
  have hc : cross M0 M1 ≠ 0 := by
    rw [hcross]; exact mul_ne_zero hpos.ne' (inv_ne_zero h)
  have hc1 : l • c0 + m • c2 ≠ 0 := by
    intro h0
    have : cross (l • c0 + m • c2) c2 = l * cross c0 c2 := by
      simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
    rw [h0] at this
    have : l * cross c0 c2 = 0 := by rw [← this]; simp [cross]
    rcases mul_eq_zero.1 this with h' | h'
    · linarith
    · exact h h'
  have hle := mah_minDet_le (K := K) hc (by
    intro y hy hyK
    obtain ⟨p, q, rfl⟩ := mah_mem_span_pair hy
    have hyH := interior_mono hK hyK
    have k0 := mah_abs_lt_of_interior (S := mah_H c0 (l • c0 + m • c2) c2)
      (mah_ne_zero_left h) (fun z hz => hz.1) hyH
    have k1 := mah_abs_lt_of_interior (S := mah_H c0 (l • c0 + m • c2) c2) hc1
      (fun z hz => hz.2.1) hyH
    have k2 := mah_abs_lt_of_interior (S := mah_H c0 (l • c0 + m • c2) c2)
      (mah_ne_zero_right h) (fun z hz => hz.2.2) hyH
    by_contra hne
    have hpq : ¬ (p = 0 ∧ q = 0) := by rintro ⟨rfl, rfl⟩; simp at hne
    rcases mah_adm (a0 := c0) (a1 := l • c0 + m • c2) (a2 := c2) d00 d11
      (by rw [d21, d20]; ring) (by rw [d01]; linarith)
      (by rw [d10, hmb]; linarith) (by rw [d21]; exact hβ')
      p q hpq with h' | h' | h' <;> linarith)
  rw [hcross, abs_mul, abs_inv, abs_of_pos hpos] at hle
  have : (4 - (l + m - 1) ^ 2 / (l * m)) / |cross c0 c2| =
      4 * ((1 - (l + m - 1) ^ 2 / (4 * l * m)) * |cross c0 c2|⁻¹) := by
    ring
  rw [this]
  linarith

private theorem mah_H_swap (b0 b1 b2 : Fin 2 → ℝ) : mah_H b0 b1 b2 = mah_H b0 b2 b1 := by
  ext x; simp only [mah_H, mem_ofPred_eq]; tauto

private theorem mah_H_rot (b0 b1 b2 : Fin 2 → ℝ) : mah_H b0 b1 b2 = mah_H b2 b0 b1 := by
  ext x; simp only [mah_H, mem_ofPred_eq]; tauto

private theorem mah_H_neg (b0 b1 b2 : Fin 2 → ℝ) : mah_H b0 (-b1) b2 = mah_H b0 b1 b2 := by
  ext x; simp only [mah_H, mem_ofPred_eq, neg_dotProduct, abs_neg]

/-- **Theorem 1, first half (in canonical form).** -/
private theorem mah_canon_lower {K : Set (Fin 2 → ℝ)} {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0)
    {l m : ℝ} (hl : 0 < l) (hm : 0 < m) (hK : K ⊆ mah_H c0 (l • c0 + m • c2) c2) :
    ENNReal.ofReal (4 * minimalDeterminant K) ≤ volume (mah_H c0 (l • c0 + m • c2) c2) := by
  rcases le_or_gt (l + m) 1 with hlm | hlm
  · -- the lines `±(l c₀ + m c₂)` are redundant: `H` is a parallelogram
    have hset : mah_H c0 (l • c0 + m • c2) c2 = mah_P c0 c2 := by
      ext x; simp only [mah_H, mah_P, mem_ofPred_eq, mah_dot_comb]
      constructor
      · rintro ⟨h0, -, h2⟩; exact ⟨h0, h2⟩
      · rintro ⟨h0, h2⟩
        refine ⟨h0, ?_, h2⟩
        calc |l * (c0 ⬝ᵥ x) + m * (c2 ⬝ᵥ x)| ≤ |l * (c0 ⬝ᵥ x)| + |m * (c2 ⬝ᵥ x)| :=
              abs_add_le _ _
          _ = l * |c0 ⬝ᵥ x| + m * |c2 ⬝ᵥ x| := by
              rw [abs_mul, abs_mul, abs_of_pos hl, abs_of_pos hm]
          _ ≤ l * 1 + m * 1 := by gcongr
          _ ≤ 1 := by linarith
    rw [hset] at hK ⊢
    rw [mah_vol_P h]
    exact ENNReal.ofReal_le_ofReal (mah_par_lower h hK)
  rcases le_or_gt (1 + m) l with hl' | hl'
  · -- the lines `±c₀` are redundant
    have hcr : cross (l • c0 + m • c2) c2 = l * cross c0 c2 := by
      simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
    have hc' : cross (l • c0 + m • c2) c2 ≠ 0 := by rw [hcr]; exact mul_ne_zero hl.ne' h
    have hset : mah_H c0 (l • c0 + m • c2) c2 = mah_P (l • c0 + m • c2) c2 := by
      ext x; simp only [mah_H, mah_P, mem_ofPred_eq]
      constructor
      · rintro ⟨-, h1, h2⟩; exact ⟨h1, h2⟩
      · rintro ⟨h1, h2⟩
        refine ⟨?_, h1, h2⟩
        rw [mah_dot_comb] at h1
        rw [abs_le] at h1 h2 ⊢
        have a1 : m * (c2 ⬝ᵥ x) ≤ m * 1 := mul_le_mul_of_nonneg_left h2.2 hm.le
        have a2 : m * (-1) ≤ m * (c2 ⬝ᵥ x) := mul_le_mul_of_nonneg_left h2.1 hm.le
        constructor
        · by_contra hu
          have : 0 < l * (-1 - c0 ⬝ᵥ x) := mul_pos hl (by linarith)
          linarith
        · by_contra hu
          have : 0 < l * (c0 ⬝ᵥ x - 1) := mul_pos hl (by linarith)
          linarith
    rw [hset] at hK ⊢
    rw [mah_vol_P hc']
    exact ENNReal.ofReal_le_ofReal (mah_par_lower hc' hK)
  rcases le_or_gt (1 + l) m with hm' | hm'
  · -- the lines `±c₂` are redundant
    have hcr : cross c0 (l • c0 + m • c2) = m * cross c0 c2 := by
      simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
    have hc' : cross c0 (l • c0 + m • c2) ≠ 0 := by rw [hcr]; exact mul_ne_zero hm.ne' h
    have hset : mah_H c0 (l • c0 + m • c2) c2 = mah_P c0 (l • c0 + m • c2) := by
      ext x; simp only [mah_H, mah_P, mem_ofPred_eq]
      constructor
      · rintro ⟨h0, h1, -⟩; exact ⟨h0, h1⟩
      · rintro ⟨h0, h1⟩
        refine ⟨h0, h1, ?_⟩
        rw [mah_dot_comb] at h1
        rw [abs_le] at h0 h1 ⊢
        have a1 : l * (c0 ⬝ᵥ x) ≤ l * 1 := mul_le_mul_of_nonneg_left h0.2 hl.le
        have a2 : l * (-1) ≤ l * (c0 ⬝ᵥ x) := mul_le_mul_of_nonneg_left h0.1 hl.le
        constructor
        · by_contra hu
          have : 0 < m * (-1 - c2 ⬝ᵥ x) := mul_pos hm (by linarith)
          linarith
        · by_contra hu
          have : 0 < m * (c2 ⬝ᵥ x - 1) := mul_pos hm (by linarith)
          linarith
    rw [hset] at hK ⊢
    rw [mah_vol_P hc']
    exact ENNReal.ofReal_le_ofReal (mah_par_lower hc' hK)
  -- a proper hexagon
  have h2 : l - m < 1 := by linarith
  have h3 : m - l < 1 := by linarith
  rw [mah_vol_H h hl hm hlm h2 h3]
  exact ENNReal.ofReal_le_ofReal (mah_hex_lower h hl hm hlm h2 h3 hK)

/-- **Mahler's Theorem 1, first half: `4 Δ(K) ≤ V(H)`** for every hexagon (or parallelogram)
`H` bounded by three pairs of symmetric lines `±L₁, ±L₂, ±L₃` that contain `K`. -/
private theorem mah_thm1 {K : Set (Fin 2 → ℝ)} {b0 b1 b2 : Fin 2 → ℝ} (h01 : cross b0 b1 ≠ 0)
    (h02 : cross b0 b2 ≠ 0) (h12 : cross b1 b2 ≠ 0) (hK : K ⊆ mah_H b0 b1 b2) :
    ENNReal.ofReal (4 * minimalDeterminant K) ≤ volume (mah_H b0 b1 b2) := by
  set δ := cross b0 b1 with hδ
  set l := cross b2 b1 / δ
  set m := cross b0 b2 / δ
  have hb2 : b2 = l • b0 + m • b1 := mah_decomp h01 b2
  have hl0 : l ≠ 0 := by
    have : cross b2 b1 ≠ 0 := by
      intro h0; apply h12; simp only [cross] at h0 ⊢; linarith
    exact div_ne_zero this h01
  have hm0 : m ≠ 0 := div_ne_zero h02 h01
  rcases lt_or_gt_of_ne hl0 with hl | hl <;> rcases lt_or_gt_of_ne hm0 with hm | hm
  · -- `-b₂ = (-l) b₀ + (-m) b₁`
    have hb : -b2 = (-l) • b0 + (-m) • b1 := by rw [hb2]; module
    have hset : mah_H b0 b1 b2 = mah_H b0 ((-l) • b0 + (-m) • b1) b1 := by
      rw [← hb, mah_H_neg, mah_H_swap]
    rw [hset] at hK ⊢
    exact mah_canon_lower h01 (by linarith) (by linarith) hK
  · -- `b₁ = (-l/m) b₀ + (1/m) b₂`
    have hb : b1 = (-l / m) • b0 + (1 / m) • b2 := by
      rw [hb2, smul_add, smul_smul, smul_smul, ← add_assoc, ← add_smul]
      field_simp
      simp
    rw [hb] at hK ⊢
    exact mah_canon_lower h02 (div_pos (by linarith) hm) (by positivity) hK
  · -- `b₀ = (1/l) b₂ + (-m/l) b₁`
    have hb : b0 = (1 / l) • b2 + (-m / l) • b1 := by
      rw [hb2, smul_add, smul_smul, smul_smul, add_assoc, ← add_smul]
      field_simp
      simp
    have hc : cross b2 b1 ≠ 0 := by
      intro h0; apply h12; simp only [cross] at h0 ⊢; linarith
    have hset : mah_H b0 b1 b2 = mah_H b2 ((1 / l) • b2 + (-m / l) • b1) b1 := by
      rw [mah_H_rot, ← hb]
    rw [hset] at hK ⊢
    exact mah_canon_lower hc (by positivity) (div_pos (by linarith) hl) hK
  · have hset : mah_H b0 b1 b2 = mah_H b0 (l • b0 + m • b1) b1 := by
      rw [← hb2, mah_H_swap]
    rw [hset] at hK ⊢
    exact mah_canon_lower h01 hl hm hK

/-! The configuration of Theorem 2 and its cyclic symmetry. -/

private theorem mah_zmod6_cases (k : ZMod 6) : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 := by
  revert k; decide

/-- The configuration of Mahler's Theorem 2: `K`, the six lattice points `P_j` on its boundary,
and `|det(P₀, P₁)| = Δ(K)`. -/
private structure mah_Setup (K : Set (Fin 2 → ℝ)) (P : ZMod 6 → Fin 2 → ℝ) : Prop where
  hK : IsSymmetricConvexDomain K
  hpar : ¬ IsParallelogram K
  hfr : ∀ j, P j ∈ frontier K
  hrel : ∀ j, P j - P (j + 1) + P (j + 2) = 0
  hsymm : ∀ j, P (j + 3) = -P j
  hX : |cross (P 0) (P 1)| = minimalDeterminant K
  hX0 : cross (P 0) (P 1) ≠ 0

/-- Symmetric tac-lines `a_j · x = 1` of `K` at the points `P_j`. -/
private structure mah_Family (K : Set (Fin 2 → ℝ)) (P a : ZMod 6 → Fin 2 → ℝ) : Prop where
  hsymm : ∀ j, a (j + 3) = -a j
  hone : ∀ j, a j ⬝ᵥ P j = 1
  hle : ∀ j, ∀ x ∈ K, a j ⬝ᵥ x ≤ 1

section Setup

variable {K : Set (Fin 2 → ℝ)} {P a : ZMod 6 → Fin 2 → ℝ}

private theorem mah_Setup.P2 (S : mah_Setup K P) : P 2 = P 1 - P 0 := by
  have := S.hrel 0
  rw [zero_add, show (0 : ZMod 6) + 2 = 2 by decide] at this
  rw [← sub_eq_zero, ← this]; abel

private theorem mah_Setup.P0 (S : mah_Setup K P) : P 0 = P 1 - P 2 := by
  rw [S.P2]; abel

private theorem mah_Setup.P3 (S : mah_Setup K P) : P 3 = -P 0 := by
  simpa using S.hsymm 0

private theorem mah_Setup.P5 (S : mah_Setup K P) : P 5 = -P 2 := by
  have := S.hsymm 2; rwa [show (2 : ZMod 6) + 3 = 5 by decide] at this

private theorem mah_Setup.cross_succ (S : mah_Setup K P) (j : ZMod 6) :
    cross (P (j + 1)) (P (j + 1 + 1)) = cross (P j) (P (j + 1)) := by
  have h : P (j + 1 + 1) = P (j + 1) - P j := by
    have := S.hrel j
    rw [show j + 1 + 1 = j + 2 by ring, ← sub_eq_zero, ← this]; abel
  rw [h]; simp only [cross, Pi.sub_apply]; ring

private theorem mah_Setup.cross_eq (S : mah_Setup K P) (k : ZMod 6) :
    cross (P k) (P (k + 1)) = cross (P 0) (P 1) := by
  have key : ∀ n : ℕ, cross (P n) (P (n + 1)) = cross (P 0) (P 1) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => push_cast; rw [S.cross_succ, ih]
  have := key k.val
  rwa [ZMod.natCast_zmod_val] at this

private theorem mah_Setup.shift (S : mah_Setup K P) (k : ZMod 6) :
    mah_Setup K (fun j => P (j + k)) where
  hK := S.hK
  hpar := S.hpar
  hfr _ := S.hfr _
  hrel j := by
    have := S.hrel (j + k)
    rwa [show j + k + 1 = j + 1 + k by ring, show j + k + 2 = j + 2 + k by ring] at this
  hsymm j := by
    have := S.hsymm (j + k)
    rwa [show j + k + 3 = j + 3 + k by ring] at this
  hX := by
    simp only [zero_add]
    rw [show (1 : ZMod 6) + k = k + 1 by ring, S.cross_eq]; exact S.hX
  hX0 := by
    simp only [zero_add]
    rw [show (1 : ZMod 6) + k = k + 1 by ring, S.cross_eq]; exact S.hX0

private theorem mah_Family.shift (F : mah_Family K P a) (k : ZMod 6) :
    mah_Family K (fun j => P (j + k)) (fun j => a (j + k)) where
  hsymm j := by
    have := F.hsymm (j + k)
    rwa [show j + k + 3 = j + 3 + k by ring] at this
  hone _ := F.hone _
  hle _ := F.hle _

private theorem mah_abs_le_of_le (hK : IsSymmetricConvexDomain K) {v : Fin 2 → ℝ}
    (hv : ∀ x ∈ K, v ⬝ᵥ x ≤ 1) : ∀ x ∈ K, |v ⬝ᵥ x| ≤ 1 := by
  intro x hx
  have h2 := hv (-x) (hK.2.2.2 x hx)
  rw [dotProduct_neg] at h2
  exact abs_le.2 ⟨by linarith, hv x hx⟩

/-- **No arc `P₀P₁` of the boundary is a segment** (Mahler's (ii), his footnote 8): no tac-line
of `K` passes through both `P₀` and `P₁`. Otherwise this tac-line, its symmetric line and a pair
of symmetric tac-lines at `±P₂` bound a parallelogram `Π ⊇ K` of area `4 |det(P₀, P₁)| = 4Δ(K)`;
since `K` is not a parallelogram, a symmetric pair of lines separating a point of `Π` from `K`
cuts `Π` down to a hexagon containing `K` of smaller area, against Theorem 1. -/
private theorem mah_no_common (S : mah_Setup K P) :
    ¬ ∃ b : Fin 2 → ℝ, b ⬝ᵥ P 0 = 1 ∧ b ⬝ᵥ P 1 = 1 ∧ ∀ x ∈ K, b ⬝ᵥ x ≤ 1 := by
  rintro ⟨b, hb0, hb1, hbK⟩
  have hK := S.hK
  obtain ⟨c, hc2, hcK⟩ := mah_supporting hK (S.hfr 2)
  have hb2 : b ⬝ᵥ P 2 = 0 := by rw [S.P2, dotProduct_sub, hb1, hb0, sub_self]
  have hX2 : cross (P 0) (P 2) = cross (P 0) (P 1) := by
    rw [S.P2]; simp only [cross, Pi.sub_apply]; ring
  have hbc : cross b c * cross (P 0) (P 1) = 1 := by
    rw [← hX2, mah_cross_mul_cross, hb0, hc2, hb2]; ring
  have hbc0 : cross b c ≠ 0 := left_ne_zero_of_mul_eq_one hbc
  have hKP : K ⊆ mah_P b c := fun x hx =>
    ⟨mah_abs_le_of_le hK hbK x hx, mah_abs_le_of_le hK hcK x hx⟩
  have hvolP : volume (mah_P b c) = ENNReal.ofReal (4 * minimalDeterminant K) := by
    rw [mah_vol_P hbc0, ← S.hX]
    congr 1
    have : |cross b c| * |cross (P 0) (P 1)| = 1 := by rw [← abs_mul, hbc, abs_one]
    rw [div_eq_iff (abs_pos.2 hbc0).ne']
    linear_combination (-4) * this
  -- `K` is not the parallelogram `Π`
  have hne : ∃ y ∈ mah_P b c, y ∉ K := by
    by_contra hcon
    push Not at hcon
    apply S.hpar
    have hKeq : K = mah_P b c := Set.Subset.antisymm hKP hcon
    refine ⟨0, mah_e b c, mah_f b c, by rw [mah_cross_e_f hbc0]; exact inv_ne_zero hbc0, ?_⟩
    rw [hKeq]
    obtain ⟨he0, he1, hf0, hf1⟩ := mah_dual hbc0
    ext x
    simp only [mah_P, mem_ofPred_eq, zero_add]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨b ⬝ᵥ x, c ⬝ᵥ x, h1, h2, mah_recon hbc0 x⟩
    · rintro ⟨s, t, hs, ht, rfl⟩
      simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, he0, he1, hf0, hf1, mul_one,
        mul_zero, add_zero, zero_add]
      exact ⟨hs, ht⟩
  obtain ⟨y, hyP, hyK⟩ := hne
  obtain ⟨d, hdK, hdy⟩ := mah_separate hK hyK
  have hdK' : ∀ x ∈ K, |d ⬝ᵥ x| < 1 := by
    intro x hx
    have h2 := hdK (-x) (hK.2.2.2 x hx)
    rw [dotProduct_neg] at h2
    exact abs_lt.2 ⟨by linarith, hdK x hx⟩
  have hP0K := mah_frontier_mem hK (S.hfr 0)
  have hP2K := mah_frontier_mem hK (S.hfr 2)
  have hbd : cross b d ≠ 0 := by
    intro h0
    have h := mah_cross_mul_cross b d (P 0) y
    rw [h0, zero_mul, hb0, one_mul] at h
    have h1 : |(b ⬝ᵥ y) * (d ⬝ᵥ P 0)| < 1 := by
      rw [abs_mul]
      calc |b ⬝ᵥ y| * |d ⬝ᵥ P 0| ≤ 1 * |d ⬝ᵥ P 0| := by gcongr; exact hyP.1
        _ < 1 := by rw [one_mul]; exact hdK' _ hP0K
    have h2 := (abs_lt.1 h1).2
    linarith
  have hdc : cross d c ≠ 0 := by
    intro h0
    have h := mah_cross_mul_cross c d (P 2) y
    have h0' : cross c d = 0 := by simp only [cross] at h0 ⊢; linarith
    rw [h0', zero_mul, hc2, one_mul] at h
    have h1 : |(c ⬝ᵥ y) * (d ⬝ᵥ P 2)| < 1 := by
      rw [abs_mul]
      calc |c ⬝ᵥ y| * |d ⬝ᵥ P 2| ≤ 1 * |d ⬝ᵥ P 2| := by gcongr; exact hyP.2
        _ < 1 := by rw [one_mul]; exact hdK' _ hP2K
    have h2 := (abs_lt.1 h1).2
    linarith
  have hKH : K ⊆ mah_H b d c := fun x hx =>
    ⟨mah_abs_le_of_le hK hbK x hx, (hdK' x hx).le, mah_abs_le_of_le hK hcK x hx⟩
  have hlow := mah_thm1 hbd hbc0 hdc hKH
  -- the open piece of `Π` cut off by `d · x = 1`
  set U : Set (Fin 2 → ℝ) := {z | |b ⬝ᵥ z| < 1 ∧ |c ⬝ᵥ z| < 1 ∧ 1 < d ⬝ᵥ z}
  have hUo : IsOpen U := by
    simp only [U, ofPred_and]
    exact (isOpen_lt (by fun_prop) continuous_const).inter
      ((isOpen_lt (by fun_prop) continuous_const).inter (isOpen_lt continuous_const (by fun_prop)))
  have hdy0 : 0 < d ⬝ᵥ y := by linarith
  have hUne : U.Nonempty := by
    set t := (1 + d ⬝ᵥ y) / (2 * (d ⬝ᵥ y)) with ht
    have ht0 : 0 < t := by positivity
    have ht1 : t < 1 := by rw [ht, div_lt_one (by positivity)]; linarith
    refine ⟨t • y, ?_, ?_, ?_⟩
    · rw [dotProduct_smul, smul_eq_mul, abs_mul, abs_of_pos ht0]
      calc t * |b ⬝ᵥ y| ≤ t * 1 := by gcongr; exact hyP.1
        _ < 1 := by linarith
    · rw [dotProduct_smul, smul_eq_mul, abs_mul, abs_of_pos ht0]
      calc t * |c ⬝ᵥ y| ≤ t * 1 := by gcongr; exact hyP.2
        _ < 1 := by linarith
    · rw [dotProduct_smul, smul_eq_mul]
      have : t * (d ⬝ᵥ y) = (1 + d ⬝ᵥ y) / 2 := by rw [ht]; field_simp
      rw [this]; linarith
  have hUpos : 0 < volume U := hUo.measure_pos volume hUne
  have hUsub : mah_H b d c ∪ U ⊆ mah_P b c := by
    rintro z (⟨h1, -, h3⟩ | ⟨h1, h2, -⟩)
    · exact ⟨h1, h3⟩
    · exact ⟨h1.le, h2.le⟩
  have hdisj : Disjoint (mah_H b d c) U := by
    rw [Set.disjoint_left]
    rintro z ⟨-, h2, -⟩ ⟨-, -, h3⟩
    have := (abs_le.1 h2).2
    linarith
  have hsum : volume (mah_H b d c) + volume U ≤ ENNReal.ofReal (4 * minimalDeterminant K) := by
    rw [← measure_union hdisj hUo.measurableSet, ← hvolP]; exact measure_mono hUsub
  have hfin : volume (mah_H b d c) ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (le_trans le_self_add hsum)
  have h3 : volume (mah_H b d c) + volume U ≤ volume (mah_H b d c) + 0 := by
    rw [add_zero]; exact le_trans hsum hlow
  have h4 := ENNReal.le_of_add_le_add_left hfin h3
  exact hUpos.ne' (le_antisymm h4 zero_le)

/-- The tac-line at `P₀` meets the boundary arc `P₅P₀P₁` only at `P₀`: `0 < a₀ · P₁ < 1`. -/
private theorem mah_alpha_bounds (S : mah_Setup K P) (F : mah_Family K P a) :
    0 < a 0 ⬝ᵥ P 1 ∧ a 0 ⬝ᵥ P 1 < 1 := by
  have hK := S.hK
  have hle1 : a 0 ⬝ᵥ P 1 ≤ 1 := F.hle 0 _ (mah_frontier_mem hK (S.hfr 1))
  have hne1 : a 0 ⬝ᵥ P 1 ≠ 1 := fun h => mah_no_common S ⟨a 0, F.hone 0, h, F.hle 0⟩
  have hP5 : P 5 = P 0 - P 1 := by rw [S.P5, S.P2]; abel
  have h5 : a 0 ⬝ᵥ P 5 = 1 - a 0 ⬝ᵥ P 1 := by rw [hP5, dotProduct_sub, F.hone 0]
  have hle5 : a 0 ⬝ᵥ P 5 ≤ 1 := F.hle 0 _ (mah_frontier_mem hK (S.hfr 5))
  have hne0 : a 0 ⬝ᵥ P 1 ≠ 0 := by
    intro h0
    apply mah_no_common (S.shift 5)
    refine ⟨a 0, ?_, ?_, F.hle 0⟩
    · show a 0 ⬝ᵥ P (0 + 5) = 1
      rw [zero_add, h5, h0, sub_zero]
    · show a 0 ⬝ᵥ P (1 + 5) = 1
      rw [show (1 : ZMod 6) + 5 = 0 by decide]; exact F.hone 0
  refine ⟨lt_of_le_of_ne (by linarith) (Ne.symm hne0), lt_of_le_of_ne hle1 hne1⟩

private theorem mah_alpha_bounds' (S : mah_Setup K P) (F : mah_Family K P a) (j : ZMod 6) :
    0 < a j ⬝ᵥ P (j + 1) ∧ a j ⬝ᵥ P (j + 1) < 1 := by
  have := mah_alpha_bounds (S.shift j) (F.shift j)
  simpa only [zero_add, add_comm (1 : ZMod 6) j] using this

end Setup

/-! The hexagon bounded by the tac-lines at the lattice points. -/

/-- `D(x, y) = 1 - x + x y`. -/
private def mah_D (x y : ℝ) : ℝ := 1 - x + x * y

private theorem mah_D_pos {x y : ℝ} (hx' : x < 1) (hy : 0 < y) (hx : 0 < x) : 0 < mah_D x y := by
  unfold mah_D; nlinarith [mul_pos hx hy]

private theorem mah_alg_coef (α0 α1 α2 : ℝ) (h : mah_D α2 α0 ≠ 0) :
    1 - α1 = mah_D α1 α2 / mah_D α2 α0 * 1 + mah_D α0 α1 / mah_D α2 α0 * -α2 ∧
    1 = mah_D α1 α2 / mah_D α2 α0 * α0 + mah_D α0 α1 / mah_D α2 α0 * (1 - α2) := by
  constructor <;> field_simp <;> unfold mah_D <;> ring

private theorem mah_alg_proper {α0 α1 α2 : ℝ} (h0 : 0 < α0) (h0' : α0 < 1) (h1 : 0 < α1)
    (h1' : α1 < 1) (h2 : 0 < α2) (h2' : α2 < 1) :
    1 < mah_D α1 α2 / mah_D α2 α0 + mah_D α0 α1 / mah_D α2 α0 ∧
    mah_D α1 α2 / mah_D α2 α0 - mah_D α0 α1 / mah_D α2 α0 < 1 ∧
    mah_D α0 α1 / mah_D α2 α0 - mah_D α1 α2 / mah_D α2 α0 < 1 := by
  have hD2 := mah_D_pos h2' h0 h2
  rw [← add_div, ← sub_div, ← sub_div, one_lt_div hD2, div_lt_one hD2, div_lt_one hD2]
  unfold mah_D
  have a := mul_pos (sub_pos.2 h0') (sub_pos.2 h1')
  have b := mul_pos (sub_pos.2 h1') (sub_pos.2 h2')
  have c := mul_pos (sub_pos.2 h2') (sub_pos.2 h0')
  have d := mul_pos h2 (sub_pos.2 h0')
  have e := mul_pos h0 (sub_pos.2 h1')
  have f := mul_pos h1 (sub_pos.2 h2')
  have g := mul_pos h1 h2
  have i := mul_pos h2 h0
  have j := mul_pos h0 h1
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith

/-- The area of the hexagon of tac-lines: `V(H) = (4 - p² / (D₀ D₁ D₂)) d(Λ)` with
`p = α₀ α₁ α₂ - (1 - α₀)(1 - α₁)(1 - α₂)`. -/
private theorem mah_alg_area (α0 α1 α2 X : ℝ) (hX : X ≠ 0) (hD0 : mah_D α0 α1 ≠ 0)
    (hD1 : mah_D α1 α2 ≠ 0) (hD2 : mah_D α2 α0 ≠ 0) :
    (4 - (mah_D α1 α2 / mah_D α2 α0 + mah_D α0 α1 / mah_D α2 α0 - 1) ^ 2 /
        (mah_D α1 α2 / mah_D α2 α0 * (mah_D α0 α1 / mah_D α2 α0))) / (mah_D α2 α0 / X) =
      (4 - (α0 * α1 * α2 - (1 - α0) * (1 - α1) * (1 - α2)) ^ 2 /
        (mah_D α0 α1 * mah_D α1 α2 * mah_D α2 α0)) * X := by
  field_simp
  unfold mah_D
  ring

private theorem mah_alg_mid (α0 α1 α2 : ℝ) (hD0 : mah_D α0 α1 ≠ 0) (hD2 : mah_D α2 α0 ≠ 0)
    (hp : α0 * α1 * α2 = (1 - α0) * (1 - α1) * (1 - α2)) :
    ((1 - mah_D α1 α2 / mah_D α2 α0) / (mah_D α0 α1 / mah_D α2 α0) - 1) / 2 = -α2 := by
  field_simp
  unfold mah_D
  linear_combination hp

private theorem mah_hexagon_eq {a : ZMod 6 → Fin 2 → ℝ} (hs : ∀ j, a (j + 3) = -a j) :
    hexagon a = mah_H (a 0) (a 1) (a 2) := by
  have a3 : a 3 = -a 0 := by simpa using hs 0
  have a4 : a 4 = -a 1 := by have := hs 1; rwa [show (1 : ZMod 6) + 3 = 4 by decide] at this
  have a5 : a 5 = -a 2 := by have := hs 2; rwa [show (2 : ZMod 6) + 3 = 5 by decide] at this
  ext x
  simp only [hexagon, mah_H, mem_ofPred_eq, abs_le]
  constructor
  · intro h
    have h3 := h 3; have h4 := h 4; have h5 := h 5
    rw [a3, neg_dotProduct] at h3
    rw [a4, neg_dotProduct] at h4
    rw [a5, neg_dotProduct] at h5
    exact ⟨⟨by linarith, h 0⟩, ⟨by linarith, h 1⟩, ⟨by linarith, h 2⟩⟩
  · rintro ⟨⟨h0, h0'⟩, ⟨h1, h1'⟩, ⟨h2, h2'⟩⟩ j
    rcases mah_zmod6_cases j with rfl | rfl | rfl | rfl | rfl | rfl
    · exact h0'
    · exact h1'
    · exact h2'
    · rw [a3, neg_dotProduct]; linarith
    · rw [a4, neg_dotProduct]; linarith
    · rw [a5, neg_dotProduct]; linarith

/-- A side of the canonical hexagon is the segment between two vertices. -/
private theorem mah_side0 {c0 c2 : Fin 2 → ℝ} (h : cross c0 c2 ≠ 0) {l m : ℝ} (hm : 0 < m)
    (h1 : 1 < l + m) (h2 : l - m < 1) (h3 : m - l < 1) :
    mah_H c0 (l • c0 + m • c2) c2 ∩ {x | c0 ⬝ᵥ x = 1} =
      segment ℝ (mah_e c0 c2 - mah_f c0 c2) (mah_e c0 c2 + ((1 - l) / m) • mah_f c0 c2) := by
  obtain ⟨he0, he2, hf0, hf2⟩ := mah_dual h
  set e := mah_e c0 c2
  set f := mah_f c0 c2
  set q := (1 - l) / m with hq
  have hq1 : q ≤ 1 := by rw [hq, div_le_one hm]; linarith
  have hq2 : -1 < q := by rw [hq, lt_div_iff₀ hm]; linarith
  have hmq : m * q = 1 - l := by rw [hq]; field_simp
  ext x
  rw [segment_eq_image]
  simp only [mah_H, mem_inter_iff, mem_ofPred_eq, mem_image, mem_Icc, mah_dot_comb]
  constructor
  · rintro ⟨⟨-, hx1, hx2⟩, hx0⟩
    rw [hx0, abs_le] at hx1
    rw [abs_le] at hx2
    have hwq : c2 ⬝ᵥ x ≤ q := by
      by_contra hcon
      have : m * q < m * (c2 ⬝ᵥ x) := mul_lt_mul_of_pos_left (by linarith) hm
      linarith
    refine ⟨(c2 ⬝ᵥ x + 1) / (q + 1),
      ⟨div_nonneg (by linarith) (by linarith), by rw [div_le_one (by linarith)]; linarith⟩, ?_⟩
    have hθ : (c2 ⬝ᵥ x + 1) / (q + 1) * (q + 1) = c2 ⬝ᵥ x + 1 :=
      div_mul_cancel₀ _ (by linarith)
    conv_rhs => rw [mah_recon h x, hx0]
    funext i
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    linear_combination (f i) * hθ
  · rintro ⟨θ, ⟨hθ0, hθ1⟩, rfl⟩
    simp only [dotProduct_add, dotProduct_sub, dotProduct_smul, smul_eq_mul, he0, he2, hf0, hf2]
    have hw1 : θ * (q + 1) ≤ q + 1 := by nlinarith
    have hw2 : 0 ≤ θ * (q + 1) := by nlinarith
    have hw3 : m * (θ * (q + 1)) ≤ m * (q + 1) := mul_le_mul_of_nonneg_left hw1 hm.le
    have hw4 : 0 ≤ m * (θ * (q + 1)) := mul_nonneg hm.le hw2
    refine ⟨⟨by norm_num, ?_, ?_⟩, by ring⟩
    · rw [abs_le]; constructor <;> nlinarith
    · rw [abs_le]; constructor <;> nlinarith

private theorem mah_midpoint (e f : Fin 2 → ℝ) (q : ℝ) :
    midpoint ℝ (e - f) (e + q • f) = e + ((q - 1) / 2) • f := by
  rw [midpoint_eq_smul_add]
  funext i
  simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, invOf_eq_inv]
  ring

section Key

variable {K : Set (Fin 2 → ℝ)} {P a : ZMod 6 → Fin 2 → ℝ}

private theorem mah_K_sub_hexagon (F : mah_Family K P a) : K ⊆ hexagon a :=
  fun x hx j => F.hle j x hx

/-- **The key computation** (Mahler's (3), (iii) and (iv)). For symmetric tac-lines `a_j · x = 1`
at the lattice points, with `α_j = a_j · P_{j+1}`: Theorem 1 (`V(H) ≥ 4Δ(K)`) and the area
`V(H) = (4 - p²/(D₀D₁D₂)) Δ(K)` force `p = α₀α₁α₂ - (1-α₀)(1-α₁)(1-α₂) = 0`; hence
`V(H) = 4Δ(K)` and `P₀` is the midpoint of its side of `H`. -/
private theorem mah_key (S : mah_Setup K P) (F : mah_Family K P a) :
    (a 0 ⬝ᵥ P 1) * (a 1 ⬝ᵥ P 2) * (a 2 ⬝ᵥ P 3) =
      (1 - a 0 ⬝ᵥ P 1) * (1 - a 1 ⬝ᵥ P 2) * (1 - a 2 ⬝ᵥ P 3) ∧
    volume (hexagon a) = ENNReal.ofReal (4 * minimalDeterminant K) ∧
    ∃ p q, hexagon a ∩ {x | a 0 ⬝ᵥ x = 1} = segment ℝ p q ∧ P 0 = midpoint ℝ p q := by
  have hK := S.hK
  have hX0 := S.hX0
  obtain ⟨h0l, h0u⟩ := mah_alpha_bounds' S F 0
  obtain ⟨h1l, h1u⟩ := mah_alpha_bounds' S F 1
  obtain ⟨h2l, h2u⟩ := mah_alpha_bounds' S F 2
  rw [zero_add] at h0l h0u
  rw [show (1 : ZMod 6) + 1 = 2 by decide] at h1l h1u
  rw [show (2 : ZMod 6) + 1 = 3 by decide] at h2l h2u
  obtain ⟨α0, hα0⟩ : ∃ α0, a 0 ⬝ᵥ P 1 = α0 := ⟨_, rfl⟩
  obtain ⟨α1, hα1⟩ : ∃ α1, a 1 ⬝ᵥ P 2 = α1 := ⟨_, rfl⟩
  obtain ⟨α2, hα2⟩ : ∃ α2, a 2 ⬝ᵥ P 3 = α2 := ⟨_, rfl⟩
  rw [hα0] at h0l h0u ⊢
  rw [hα1] at h1l h1u ⊢
  rw [hα2] at h2l h2u ⊢
  have v00 : a 0 ⬝ᵥ P 0 = 1 := F.hone 0
  have v11 : a 1 ⬝ᵥ P 1 = 1 := F.hone 1
  have v10 : a 1 ⬝ᵥ P 0 = 1 - α1 := by rw [S.P0, dotProduct_sub, v11, hα1]
  have v20 : a 2 ⬝ᵥ P 0 = -α2 := by
    rw [show P 0 = -P 3 by rw [S.P3, neg_neg], dotProduct_neg, hα2]
  have v21 : a 2 ⬝ᵥ P 1 = 1 - α2 := by
    rw [show P 1 = P 0 + P 2 by rw [S.P2]; abel, dotProduct_add, v20, F.hone 2]; ring
  have hD0 := mah_D_pos h0u h1l h0l
  have hD1 := mah_D_pos h1u h2l h1l
  have hD2 := mah_D_pos h2u h0l h2l
  set l := mah_D α1 α2 / mah_D α2 α0 with hl_def
  set m := mah_D α0 α1 / mah_D α2 α0 with hm_def
  have hl : 0 < l := div_pos hD1 hD2
  have hm : 0 < m := div_pos hD0 hD2
  obtain ⟨hp1, hp2, hp3⟩ := mah_alg_proper h0l h0u h1l h1u h2l h2u
  obtain ⟨hc1, hc2⟩ := mah_alg_coef α0 α1 α2 hD2.ne'
  have ha1 : a 1 = l • a 0 + m • a 2 := by
    apply mah_eq_of_dot hX0
    · rw [mah_dot_comb, v00, v10, v20]; exact hc1
    · rw [mah_dot_comb, v11, hα0, v21]; exact hc2
  have hc : cross (a 0) (a 2) * cross (P 0) (P 1) = mah_D α2 α0 := by
    rw [mah_cross_mul_cross, v00, v21, hα0, v20]; unfold mah_D; ring
  have hc02 : cross (a 0) (a 2) ≠ 0 := by
    intro h0; rw [h0, zero_mul] at hc; linarith
  have habs : |cross (a 0) (a 2)| = mah_D α2 α0 / |cross (P 0) (P 1)| := by
    rw [eq_div_iff (abs_pos.2 hX0).ne', ← abs_mul, hc, abs_of_pos hD2]
  have hhex : hexagon a = mah_H (a 0) (l • a 0 + m • a 2) (a 2) := by
    rw [mah_hexagon_eq F.hsymm, ha1]
  have hKH : K ⊆ mah_H (a 0) (l • a 0 + m • a 2) (a 2) := hhex ▸ mah_K_sub_hexagon F
  have harea := mah_alg_area α0 α1 α2 _ (abs_pos.2 hX0).ne' hD0.ne' hD1.ne' hD2.ne'
  -- Theorem 1: `4Δ(K) ≤ V(H)`
  have hlow := mah_hex_lower hc02 hl hm hp1 hp2 hp3 hKH
  rw [habs, ← S.hX, harea] at hlow
  have hp : α0 * α1 * α2 = (1 - α0) * (1 - α1) * (1 - α2) := by
    set p := α0 * α1 * α2 - (1 - α0) * (1 - α1) * (1 - α2)
    have hpos : 0 < mah_D α0 α1 * mah_D α1 α2 * mah_D α2 α0 := by positivity
    have hX' : 0 < |cross (P 0) (P 1)| := abs_pos.2 hX0
    have h4 : p ^ 2 / (mah_D α0 α1 * mah_D α1 α2 * mah_D α2 α0) * |cross (P 0) (P 1)| ≤ 0 := by
      nlinarith
    have h5 : p ^ 2 ≤ 0 := by
      by_contra hcon
      push Not at hcon
      have := mul_pos (div_pos hcon hpos) hX'
      linarith
    have : p = 0 := pow_eq_zero_iff (two_ne_zero) |>.1 (le_antisymm h5 (sq_nonneg p))
    linear_combination this
  refine ⟨hp, ?_, ?_⟩
  · -- `V(H) = 4Δ(K)`
    rw [hhex, mah_vol_H hc02 hl hm hp1 hp2 hp3, habs, harea, ← S.hX]
    congr 1
    rw [show α0 * α1 * α2 - (1 - α0) * (1 - α1) * (1 - α2) = 0 by linear_combination hp]
    ring
  · -- `P₀` bisects its side
    refine ⟨_, _, by rw [hhex]; exact mah_side0 hc02 hm hp1 hp2 hp3, ?_⟩
    rw [mah_midpoint]
    obtain ⟨he0, he2, hf0, hf2⟩ := mah_dual hc02
    apply mah_eq_of_dot' hc02
    · simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, he0, hf0, v00]; ring
    · simp only [dotProduct_add, dotProduct_smul, smul_eq_mul, he2, hf2, v20]
      rw [mah_alg_mid α0 α1 α2 hD0.ne' hD2.ne' hp]; ring

end Key

/-! Tac-lines. -/

/-- Two equations of the same line: `{b · x = 1} = {c · x = γ}` forces `c = γ b`. -/
private theorem mah_line_eq {b c z : Fin 2 → ℝ} {γ : ℝ} (hz : b ⬝ᵥ z = 1)
    (h : {x | b ⬝ᵥ x = 1} = {x | c ⬝ᵥ x = γ}) : c = γ • b := by
  have hz' : c ⬝ᵥ z = γ := by
    have : z ∈ {x | b ⬝ᵥ x = 1} := hz
    rw [h] at this; exact this
  set bp : Fin 2 → ℝ := ![-b 1, b 0] with hbp_def
  have hbp : b ⬝ᵥ bp = 0 := by
    simp only [bp, mah_dot, Matrix.cons_val_zero, Matrix.cons_val_one]; ring
  have h2 : c ⬝ᵥ (z + bp) = γ := by
    have : z + bp ∈ {x | b ⬝ᵥ x = 1} := by
      change b ⬝ᵥ (z + bp) = 1
      rw [dotProduct_add, hz, hbp, add_zero]
    rw [h] at this; exact this
  rw [dotProduct_add, hz'] at h2
  have hcb : cross b c = 0 := by
    have : c ⬝ᵥ bp = 0 := by linarith
    simp only [bp, mah_dot, Matrix.cons_val_zero, Matrix.cons_val_one] at this
    simp only [cross]; linarith
  have := mah_smul_of_cross_eq_zero hcb z
  rwa [hz, one_smul, hz'] at this

variable {K : Set (Fin 2 → ℝ)}

/-- A tac-line `b · x = 1` has `K` on the side `b · x ≤ 1` and touches `K`. -/
private theorem mah_tacLine (hK : IsSymmetricConvexDomain K) {b : Fin 2 → ℝ}
    (h : IsTacLine K {x | b ⬝ᵥ x = 1}) : (∀ x ∈ K, b ⬝ᵥ x ≤ 1) ∧ ∃ z ∈ K, b ⬝ᵥ z = 1 := by
  obtain ⟨⟨c, hc, γ, hℓ, hcK⟩, ⟨z, hzℓ, hzK⟩⟩ := h
  have hz : b ⬝ᵥ z = 1 := hzℓ
  have hcb := mah_line_eq hz hℓ
  have hγpos : 0 < γ := by
    have := mah_lt_of_interior hc hcK (mah_zero_mem_interior hK)
    rwa [dotProduct_zero] at this
  refine ⟨fun x hx => ?_, z, hzK, hz⟩
  have := hcK x hx
  rw [hcb, smul_dotProduct, smul_eq_mul] at this
  exact (mul_le_iff_le_one_right hγpos).1 this

/-- Every tac-line through a point `p` is `{b · x = 1}` with `b · p = 1` and `K ⊆ {b · x ≤ 1}`. -/
private theorem mah_tacLine_normalize (hK : IsSymmetricConvexDomain K) {ℓ : Set (Fin 2 → ℝ)}
    (h : IsTacLine K ℓ) {p : Fin 2 → ℝ} (hp : p ∈ ℓ) :
    ∃ b : Fin 2 → ℝ, ℓ = {x | b ⬝ᵥ x = 1} ∧ b ⬝ᵥ p = 1 ∧ ∀ x ∈ K, b ⬝ᵥ x ≤ 1 := by
  obtain ⟨⟨c, hc, γ, rfl, hcK⟩, -⟩ := h
  have hγpos : 0 < γ := by
    have := mah_lt_of_interior hc hcK (mah_zero_mem_interior hK)
    rwa [dotProduct_zero] at this
  have hp' : c ⬝ᵥ p = γ := hp
  refine ⟨γ⁻¹ • c, ?_, ?_, fun x hx => ?_⟩
  · ext x
    simp only [mem_ofPred_eq, smul_dotProduct, smul_eq_mul]
    constructor
    · intro hx; rw [hx, inv_mul_cancel₀ hγpos.ne']
    · intro hx; field_simp at hx; linarith
  · rw [smul_dotProduct, smul_eq_mul, hp', inv_mul_cancel₀ hγpos.ne']
  · rw [smul_dotProduct, smul_eq_mul, inv_mul_le_iff₀ hγpos, mul_one]; exact hcK x hx

/-- Distinct, non-opposite symmetric tac-lines are not parallel. -/
private theorem mah_cross_ne_of_tac (hK : IsSymmetricConvexDomain K) {b c : Fin 2 → ℝ}
    (hb : IsTacLine K {x | b ⬝ᵥ x = 1}) (hc : IsTacLine K {x | c ⬝ᵥ x = 1}) (h1 : c ≠ b)
    (h2 : c ≠ -b) : cross b c ≠ 0 := by
  intro h0
  obtain ⟨hbK, zb, hzbK, hzb⟩ := mah_tacLine hK hb
  obtain ⟨hcK, zc, hzcK, hzc⟩ := mah_tacLine hK hc
  have := mah_smul_of_cross_eq_zero h0 zb
  rw [hzb, one_smul] at this
  -- `c = γ b` with `γ = c · z_b`
  set γ := c ⬝ᵥ zb
  have hγ1 : γ ≤ 1 := hcK zb hzbK
  have hγ2 : -γ ≤ 1 := by
    have := hcK (-zb) (hK.2.2.2 zb hzbK)
    rwa [dotProduct_neg] at this
  have hw1 : b ⬝ᵥ zc ≤ 1 := hbK zc hzcK
  have hw2 : -(b ⬝ᵥ zc) ≤ 1 := by
    have := hbK (-zc) (hK.2.2.2 zc hzcK)
    rwa [dotProduct_neg] at this
  have h3 : γ * (b ⬝ᵥ zc) = 1 := by
    rw [← hzc, this, smul_dotProduct, smul_eq_mul]
  have hγ : γ = 1 ∨ γ = -1 := by
    have habs : |γ| * |b ⬝ᵥ zc| = 1 := by rw [← abs_mul, h3, abs_one]
    have hw : |b ⬝ᵥ zc| ≤ 1 := abs_le.2 ⟨by linarith, hw1⟩
    have hg : |γ| ≤ 1 := abs_le.2 ⟨by linarith, hγ1⟩
    have : |γ| = 1 := by
      apply le_antisymm hg
      by_contra hlt
      push Not at hlt
      have : |γ| * |b ⬝ᵥ zc| < 1 :=
        lt_of_le_of_lt (mul_le_of_le_one_right (abs_nonneg _) hw) hlt
      linarith
    rcases abs_eq (zero_le_one) |>.1 this with h | h
    · exact Or.inl h
    · exact Or.inr h
  rcases hγ with h | h
  · apply h1; rw [this, h, one_smul]
  · apply h2; rw [this, h, neg_one_smul]

section Main

variable {P a : ZMod 6 → Fin 2 → ℝ}

/-- **Uniqueness of the tac-line at `P₀`** (Mahler's (i)). If `b · x = 1` were another tac-line
at `P₀`, the hexagon with it in place of `a₀ · x = 1` would also have `p = 0`; but `p` is
strictly increasing in `α₀ = a₀ · P₁` (Mahler: the area would vary with the tac-line). -/
private theorem mah_unique0 (S : mah_Setup K P) (F : mah_Family K P a) {b : Fin 2 → ℝ}
    (hb : b ⬝ᵥ P 0 = 1) (hbK : ∀ x ∈ K, b ⬝ᵥ x ≤ 1) : b = a 0 := by
  classical
  set a' : ZMod 6 → Fin 2 → ℝ := fun j => if j = 0 then b else if j = 3 then -b else a j
    with ha'
  have h30 : (3 : ZMod 6) ≠ 0 := by decide
  have h33 : (3 : ZMod 6) + 3 = 0 := by decide
  have F' : mah_Family K P a' := by
    refine ⟨fun j => ?_, fun j => ?_, fun j => ?_⟩
    · by_cases hj0 : j = 0
      · subst hj0; simp [a', h30]
      by_cases hj3 : j = 3
      · subst hj3; simp [a', h33, h30]
      have h1 : j + 3 ≠ 0 := fun h => hj3 (by
        have := eq_neg_of_add_eq_zero_left h
        rw [this]; decide)
      have h2 : j + 3 ≠ 3 := fun h => hj0 (by simpa using h)
      simp [a', hj0, hj3, h1, h2, F.hsymm j]
    · by_cases hj0 : j = 0
      · subst hj0; simp [a', hb]
      by_cases hj3 : j = 3
      · subst hj3; simp [a', h30, S.P3, hb]
      simp [a', hj0, hj3, F.hone j]
    · intro x hx
      change (if j = 0 then b else if j = 3 then -b else a j) ⬝ᵥ x ≤ 1
      by_cases hj0 : j = 0
      · rw [ite_eq_left hj0]; exact hbK x hx
      by_cases hj3 : j = 3
      · rw [ite_eq_right hj0, ite_eq_left hj3, neg_dotProduct, ← dotProduct_neg]
        exact hbK (-x) (S.hK.2.2.2 x hx)
      rw [ite_eq_right hj0, ite_eq_right hj3]; exact F.hle j x hx
  have k := (mah_key S F).1
  have k' := (mah_key S F').1
  have e0 : a' 0 = b := by simp [a']
  have e1 : a' 1 = a 1 := by
    simp [a', show (1 : ZMod 6) ≠ 0 by decide, show (1 : ZMod 6) ≠ 3 by decide]
  have e2 : a' 2 = a 2 := by
    simp [a', show (2 : ZMod 6) ≠ 0 by decide, show (2 : ZMod 6) ≠ 3 by decide]
  rw [e0, e1, e2] at k'
  obtain ⟨h1l, h1u⟩ := mah_alpha_bounds' S F 1
  obtain ⟨h2l, h2u⟩ := mah_alpha_bounds' S F 2
  rw [show (1 : ZMod 6) + 1 = 2 by decide] at h1l h1u
  rw [show (2 : ZMod 6) + 1 = 3 by decide] at h2l h2u
  have hcoef : 0 < (a 1 ⬝ᵥ P 2) * (a 2 ⬝ᵥ P 3) + (1 - a 1 ⬝ᵥ P 2) * (1 - a 2 ⬝ᵥ P 3) := by
    have := mul_pos h1l h2l
    have := mul_pos (sub_pos.2 h1u) (sub_pos.2 h2u)
    linarith
  have hα : b ⬝ᵥ P 1 = a 0 ⬝ᵥ P 1 := by
    have : (b ⬝ᵥ P 1 - a 0 ⬝ᵥ P 1) *
        ((a 1 ⬝ᵥ P 2) * (a 2 ⬝ᵥ P 3) + (1 - a 1 ⬝ᵥ P 2) * (1 - a 2 ⬝ᵥ P 3)) = 0 := by
      linear_combination k' - k
    rcases mul_eq_zero.1 this with h | h
    · linarith
    · linarith
  exact mah_eq_of_dot S.hX0 (by rw [hb, F.hone 0]) hα

/-- **No two of the tac-lines coincide** (Mahler's (ii)). -/
private theorem mah_injective (S : mah_Setup K P) (F : mah_Family K P a) :
    ∀ i j, i ≠ j → a i ≠ a j := by
  have hne1 : ∀ k, a k ≠ a (k + 1) := by
    intro k h
    have h1 := (mah_alpha_bounds' S F k).2
    have h2 := F.hone (k + 1)
    rw [← h] at h2; linarith
  have hne2 : ∀ k, a k ≠ a (k + 2) := by
    intro k h
    have h1 := (mah_alpha_bounds' S F k).2
    have hP : P (k + 2) = P (k + 1) - P k := by
      rw [← sub_eq_zero, ← S.hrel k]; abel
    have h2 := F.hone (k + 2)
    rw [← h, hP, dotProduct_sub, F.hone k] at h2; linarith
  have hne3 : ∀ k, a k ≠ a (k + 3) := by
    intro k h
    rw [F.hsymm k] at h
    have h0 : a k = 0 := by
      have : (2 : ℝ) • a k = 0 := by rw [two_smul]; nth_rewrite 2 [h]; exact add_neg_cancel _
      exact (smul_eq_zero.1 this).resolve_left two_ne_zero
    have := F.hone k
    rw [h0, zero_dotProduct] at this; exact zero_ne_one this
  intro i j hij
  obtain ⟨d, rfl⟩ : ∃ d, j = i + d := ⟨j - i, by ring⟩
  have hd : d ≠ 0 := by rintro rfl; simp at hij
  rcases mah_zmod6_cases d with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd rfl hd
  · exact hne1 i
  · exact hne2 i
  · exact hne3 i
  · intro h; apply hne2 (i + 4)
    rw [← h, add_assoc, show (4 : ZMod 6) + 2 = 0 by decide, add_zero]
  · intro h; apply hne1 (i + 5)
    rw [← h, add_assoc, show (5 : ZMod 6) + 1 = 0 by decide, add_zero]

private theorem mah_hexagon_shift (a : ZMod 6 → Fin 2 → ℝ) (k : ZMod 6) :
    hexagon (fun j => a (j + k)) = hexagon a := by
  ext x
  simp only [hexagon, mem_ofPred_eq]
  constructor
  · intro h j; simpa using h (j - k)
  · intro h j; exact h (j + k)

/-- All the conclusions of Mahler's Theorem 2 for symmetric tac-lines at the lattice points. -/
private theorem mah_isMahler (S : mah_Setup K P) (F : mah_Family K P a) :
    IsMahlerHexagon K P a := by
  have hK := S.hK
  have hne : ∀ j, a j ≠ 0 := fun j h => by
    have := F.hone j; rw [h, zero_dotProduct] at this; exact zero_ne_one this
  have hvol := (mah_key S F).2.1
  refine ⟨F.hsymm, fun j => ⟨⟨⟨a j, hne j, 1, rfl, F.hle j⟩,
    ⟨P j, F.hone j, mah_frontier_mem hK (S.hfr j)⟩⟩, F.hone j⟩, ?_, mah_injective S F, ?_,
    ?_, ?_⟩
  · -- (i) the tac-line at `P_j` is unique
    intro j ℓ hℓ hPℓ
    obtain ⟨b, rfl, hb1, hbK⟩ := mah_tacLine_normalize hK hℓ hPℓ
    have := mah_unique0 (S.shift j) (F.shift j) (b := b) (by simpa using hb1) hbK
    simp only [zero_add] at this
    rw [this]
  · -- (iii) `V(H) = 4Δ(K)`
    rw [measureReal_def, hvol, ENNReal.toReal_ofReal (by linarith [mah_minDet_nonneg K])]
  · -- (iv) each side is bisected at `P_j`
    intro j
    obtain ⟨p, q, h1, h2⟩ := (mah_key (S.shift j) (F.shift j)).2.2
    refine ⟨p, q, ?_, by simpa using h2⟩
    rw [← h1, mah_hexagon_shift]; simp only [zero_add]
  · -- minimality (Theorem 1)
    intro b hbs hbinj hbt
    rw [hvol, mah_hexagon_eq hbs]
    have hb3 : b 3 = -b 0 := by simpa using hbs 0
    have hb4 : b 4 = -b 1 := by
      have := hbs 1; rwa [show (1 : ZMod 6) + 3 = 4 by decide] at this
    have hb5 : b 5 = -b 2 := by
      have := hbs 2; rwa [show (2 : ZMod 6) + 3 = 5 by decide] at this
    have c01 := mah_cross_ne_of_tac hK (hbt 0) (hbt 1) (hbinj 1 0 (by decide))
      (by rw [← hb3]; exact hbinj 1 3 (by decide))
    have c02 := mah_cross_ne_of_tac hK (hbt 0) (hbt 2) (hbinj 2 0 (by decide))
      (by rw [← hb3]; exact hbinj 2 3 (by decide))
    have c12 := mah_cross_ne_of_tac hK (hbt 1) (hbt 2) (hbinj 2 1 (by decide))
      (by rw [← hb4]; exact hbinj 2 4 (by decide))
    have hKb : K ⊆ mah_H (b 0) (b 1) (b 2) := by
      intro x hx
      exact ⟨mah_abs_le_of_le hK (mah_tacLine hK (hbt 0)).1 x hx,
        mah_abs_le_of_le hK (mah_tacLine hK (hbt 1)).1 x hx,
        mah_abs_le_of_le hK (mah_tacLine hK (hbt 2)).1 x hx⟩
    exact mah_thm1 c01 c02 c12 hKb

end Main

/-! From the hypotheses of the theorem to the configuration. -/

/-- The six lattice points form a basis triple: `Λ` is generated by `P₀, P₁` (every other point of
`Λ` would give a nonzero lattice point inside `K`). -/
private theorem mah_lattice_eq (hK : IsSymmetricConvexDomain K) {Λ : Submodule ℤ (Fin 2 → ℝ)}
    (hadm : IsAdmissible K Λ) {P0 P1 P2 : Fin 2 → ℝ} (h0 : P0 ∈ Λ) (h1 : P1 ∈ Λ)
    (hK0 : P0 ∈ K) (hK1 : P1 ∈ K) (hK2 : P2 ∈ K) (h2 : P2 = P1 - P0) (hX : cross P0 P1 ≠ 0) :
    Λ = Submodule.span ℤ {P0, P1} := by
  apply le_antisymm
  · intro x hx
    set s := cross x P1 / cross P0 P1
    set t := cross P0 x / cross P0 P1
    have hxd : x = s • P0 + t • P1 := mah_decomp hX x
    set x' := x - ⌊s⌋ • P0 - ⌊t⌋ • P1 with hx'
    have hx'Λ : x' ∈ Λ := Λ.sub_mem (Λ.sub_mem hx (Λ.smul_mem _ h0)) (Λ.smul_mem _ h1)
    have hx'eq : x' = Int.fract s • P0 + Int.fract t • P1 := by
      rw [hx', ← Int.cast_smul_eq_zsmul ℝ, ← Int.cast_smul_eq_zsmul ℝ, Int.fract, Int.fract]
      conv_lhs => rw [hxd]
      module
    have hli : ∀ σ τ : ℝ, σ • P0 + τ • P1 = 0 → σ = 0 ∧ τ = 0 := by
      intro σ τ h
      have e1 : cross (σ • P0 + τ • P1) P1 = σ * cross P0 P1 := by
        simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
      have e2 : cross P0 (σ • P0 + τ • P1) = τ * cross P0 P1 := by
        simp only [cross, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
      rw [h] at e1 e2
      simp only [cross, Pi.zero_apply, zero_mul, mul_zero, sub_zero] at e1 e2
      exact ⟨(mul_eq_zero.1 e1.symm).resolve_right hX, (mul_eq_zero.1 e2.symm).resolve_right hX⟩
    have hfs := Int.fract_nonneg s
    have hfs' := Int.fract_lt_one s
    have hft := Int.fract_nonneg t
    have hft' := Int.fract_lt_one t
    have hzero : Int.fract s = 0 ∧ Int.fract t = 0 := by
      by_cases hst : Int.fract s + Int.fract t < 1
      · have hint := mah_combo_interior hK hK0 hK1 hfs hft hst
        rw [← hx'eq] at hint
        have := hadm x' hx'Λ hint
        rw [hx'eq] at this
        exact hli _ _ this
      · push Not at hst
        exfalso
        have hint := mah_combo_interior hK hK1 hK2
          (by linarith : (0 : ℝ) ≤ Int.fract s + Int.fract t - 1)
          (by linarith : (0 : ℝ) ≤ 1 - Int.fract s) (by linarith)
        have heq : (Int.fract s + Int.fract t - 1) • P1 + (1 - Int.fract s) • P2 = x' - P0 := by
          rw [hx'eq, h2]; module
        rw [heq] at hint
        have h0' := hadm (x' - P0) (Λ.sub_mem hx'Λ h0) hint
        rw [hx'eq] at h0'
        have := hli (-(1 - Int.fract s)) (Int.fract t) (by rw [← h0']; module)
        linarith [this.1]
    rw [Submodule.mem_span_pair]
    refine ⟨⌊s⌋, ⌊t⌋, ?_⟩
    have : x' = 0 := by rw [hx'eq, hzero.1, hzero.2]; simp
    rw [hx', sub_sub, sub_eq_zero] at this
    exact this.symm
  · rw [Submodule.span_le]
    rintro y (rfl | rfl)
    · exact h0
    · exact h1

private theorem mah_setup_of (hK : IsSymmetricConvexDomain K) (hpar : ¬ IsParallelogram K)
    {Λ : Submodule ℤ (Fin 2 → ℝ)} (hΛ : IsCritical K Λ) {P : ZMod 6 → Fin 2 → ℝ}
    (hPΛ : ∀ j, P j ∈ Λ) (hPK : ∀ j, P j ∈ frontier K) (h012 : P 0 - P 1 + P 2 = 0)
    (hsymm : ∀ j, P (j + 3) = -P j) : mah_Setup K P := by
  have P3 : P 3 = -P 0 := by simpa using hsymm 0
  have P4 : P 4 = -P 1 := by have := hsymm 1; rwa [show (1 : ZMod 6) + 3 = 4 by decide] at this
  have P5 : P 5 = -P 2 := by have := hsymm 2; rwa [show (2 : ZMod 6) + 3 = 5 by decide] at this
  have hP2 : P 2 = P 1 - P 0 := by rw [← sub_eq_zero, ← h012]; abel
  have hrel : ∀ j, P j - P (j + 1) + P (j + 2) = 0 := by
    intro j
    rcases mah_zmod6_cases j with rfl | rfl | rfl | rfl | rfl | rfl
    · simpa using h012
    · rw [show (1 : ZMod 6) + 1 = 2 by decide, show (1 : ZMod 6) + 2 = 3 by decide, P3,
        ← neg_eq_zero, ← h012]; abel
    · rw [show (2 : ZMod 6) + 1 = 3 by decide, show (2 : ZMod 6) + 2 = 4 by decide, P3, P4,
        ← h012]; abel
    · rw [show (3 : ZMod 6) + 1 = 4 by decide, show (3 : ZMod 6) + 2 = 5 by decide, P3, P4, P5,
        ← neg_eq_zero, ← h012]; abel
    · rw [show (4 : ZMod 6) + 1 = 5 by decide, show (4 : ZMod 6) + 2 = 0 by decide, P4, P5,
        ← h012]; abel
    · rw [show (5 : ZMod 6) + 1 = 0 by decide, show (5 : ZMod 6) + 2 = 1 by decide, P5,
        ← neg_eq_zero, ← h012]; abel
  have hX0 : cross (P 0) (P 1) ≠ 0 := by
    intro h0
    obtain ⟨t, ht0, -⟩ := mah_supporting hK (hPK 0)
    have h := mah_smul_of_cross_eq_zero (a := P 1) (b := P 0) h0 t
    rw [dotProduct_comm (P 0) t, ht0, one_smul] at h
    obtain ⟨γ, hγ⟩ : ∃ γ, P 1 ⬝ᵥ t = γ := ⟨_, rfl⟩
    rw [hγ] at h
    have h1 := mah_smul_frontier hK (hPK 0) (by rw [← h]; exact hPK 1)
    have h2 := mah_smul_frontier hK (hPK 0) (t := γ - 1) (by
      rw [sub_smul, one_smul, ← h, ← hP2]; exact hPK 2)
    rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> linarith
  have hΛeq := mah_lattice_eq hK hΛ.2.1 (hPΛ 0) (hPΛ 1) (mah_frontier_mem hK (hPK 0))
    (mah_frontier_mem hK (hPK 1)) (mah_frontier_mem hK (hPK 2)) hP2 hX0
  have hdet := (mah_lattice (P 0) (P 1) hX0).2
  rw [← hΛeq, hΛ.2.2] at hdet
  exact ⟨hK, hpar, hPK, hrel, hsymm, hdet.symm, hX0⟩

end Proof

end Mahler1947

open Mahler1947 in
/-- **Mahler (1947).** Let `K` be a symmetric convex domain which is not a parallelogram, `Λ` a
critical lattice of `K`, and `P₀, …, P₅` points of `Λ` on the boundary of `K` with
`P₀ - P₁ + P₂ = 0` and `P_{j+3} = -P_j`. Then there are unique symmetric tac-lines of `K` at these
points such that no two of them coincide, the hexagon `H` bounded by them has area
`area(H) = 4Δ(K)`, each side of `H` is bisected at the point `P_j` where it touches the boundary of
`K`, and `area(H)` is the least area of a hexagon bounded by symmetric tac-lines of `K`.

The minimality is Mahler's Theorem 1 (`Δ(K) = ¼ inf_H V(H)` over the hexagons and parallelograms
bounded by symmetric tac-lines, the bound being attained); here it is compared only with hexagons
bounded by six distinct symmetric tac-lines, which is no stronger. Mahler takes all the points of
`Λ` on the boundary; for a domain that is not a parallelogram these are six points as above.

Departure from the paper: Mahler cites Lemma 5 (`Δ(H) = ¼ V(H)` for a convex hexagon, whose only
critical lattice is generated by the midpoints of its sides) and, in footnote 8, Lemma 5 of an
earlier paper (no boundary arc between consecutive lattice points is a segment). Here the half
`Δ(H) ≤ ¼ V(H)` of Lemma 5 is proved with the midpoint lattice. For the hexagon `H` of tac-lines at
the lattice points, Mahler's step `(2)` (`V(H) ≤ 4 d(Λ)`, from Lemma 1 and the other half of
Lemma 5, Minkowski's theorem) and the uniqueness of the critical lattice of `H` are replaced by
the explicit area `V(H) = (4 - p² / (D₀ D₁ D₂)) d(Λ)`, which gives both. Footnote 8 is proved
from Theorem 1: a tac-line through two consecutive lattice points would give a circumscribed
parallelogram of area `4Δ(K)`, and cutting off a point of it outside `K` would give a
circumscribed hexagon of smaller area. -/
theorem mahler_1947 {K : Set (Fin 2 → ℝ)} (hK : IsSymmetricConvexDomain K)
    (hpar : ¬ IsParallelogram K) {Λ : Submodule ℤ (Fin 2 → ℝ)} (hΛ : IsCritical K Λ)
    {P : ZMod 6 → Fin 2 → ℝ} (hPΛ : ∀ j, P j ∈ Λ) (hPK : ∀ j, P j ∈ frontier K)
    (h012 : P 0 - P 1 + P 2 = 0) (hsymm : ∀ j, P (j + 3) = -P j) :
    ∃! a, IsMahlerHexagon K P a := by
  have S := mah_setup_of hK hpar hΛ hPΛ hPK h012 hsymm
  obtain ⟨t0, ht0, ht0K⟩ := mah_supporting hK (hPK 0)
  obtain ⟨t1, ht1, ht1K⟩ := mah_supporting hK (hPK 1)
  obtain ⟨t2, ht2, ht2K⟩ := mah_supporting hK (hPK 2)
  have P4 : P 4 = -P 1 := by have := hsymm 1; rwa [show (1 : ZMod 6) + 3 = 4 by decide] at this
  have hneg : ∀ t : Fin 2 → ℝ, (∀ x ∈ K, t ⬝ᵥ x ≤ 1) → ∀ x ∈ K, (-t) ⬝ᵥ x ≤ 1 := by
    intro t ht x hx
    rw [neg_dotProduct, ← dotProduct_neg]; exact ht (-x) (hK.2.2.2 x hx)
  let a : ZMod 6 → Fin 2 → ℝ := ![t0, t1, t2, -t0, -t1, -t2]
  have F : mah_Family K P a := by
    refine ⟨fun j => ?_, fun j => ?_, fun j => ?_⟩
    · rcases mah_zmod6_cases j with rfl | rfl | rfl | rfl | rfl | rfl
      · rfl
      · rfl
      · rfl
      · change t0 = - -t0; rw [neg_neg]
      · change t1 = - -t1; rw [neg_neg]
      · change t2 = - -t2; rw [neg_neg]
    · rcases mah_zmod6_cases j with rfl | rfl | rfl | rfl | rfl | rfl
      · exact ht0
      · exact ht1
      · exact ht2
      · change (-t0) ⬝ᵥ P 3 = 1; rw [S.P3, neg_dotProduct, dotProduct_neg, neg_neg, ht0]
      · change (-t1) ⬝ᵥ P 4 = 1; rw [P4, neg_dotProduct, dotProduct_neg, neg_neg, ht1]
      · change (-t2) ⬝ᵥ P 5 = 1; rw [S.P5, neg_dotProduct, dotProduct_neg, neg_neg, ht2]
    · rcases mah_zmod6_cases j with rfl | rfl | rfl | rfl | rfl | rfl
      · exact ht0K
      · exact ht1K
      · exact ht2K
      · exact hneg t0 ht0K
      · exact hneg t1 ht1K
      · exact hneg t2 ht2K
  have ha := mah_isMahler S F
  refine ⟨a, ha, fun a' ha' => ?_⟩
  funext j
  have h1 := ha'.2.1 j
  have h2 := ha.2.2.1 j _ h1.1 h1.2
  have := mah_line_eq (F.hone j) h2.symm
  rw [this, one_smul]

end External
