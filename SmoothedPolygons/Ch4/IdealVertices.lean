module

public import SmoothedPolygons.Ch4.StarDomain
public import Mathlib.Topology.Compactification.OnePoint.ProjectiveLine
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.GroupAction.Defs

/-!
# The dihedral group on the ideal vertices of `𝔥*` (§4.6)

The star domain `𝔥* = {x + iy | |x| < 1/√3, x² + y² > 1/3}` is an ideal triangle of the upper
half-plane with ideal vertices `±1/√3` and `+∞`, points of the boundary `ℝ ∪ {∞}` of the upper
half-plane, viewed as the real projective line `ℝℙ¹`. The dihedral group of the hexagon, generated
by the rotation `R` and the reflection `S` (`reflS`), permutes them, acting by linear fractional
transformations on `ℝℙ¹`: `R · (+∞) = 1/√3`, `R · (1/√3) = -1/√3`, `R · (-1/√3) = +∞`,
`S · (±1/√3) = ∓1/√3`.

`ℝℙ¹` is Mathlib's `OnePoint ℝ`, on which `GL₂(ℝ)` acts by linear fractional transformations
`x ↦ (ax + b)/(cx + d)` (`OnePoint.instGLAction`, through `OnePoint ℝ ≃ ℙ¹(ℝ)`). The actions on the
controls, the star functions and `Φ` are in `SmoothedPolygons.Ch4.StarDomain`
(`R_conj_controlMatrix_vertex`, `ρ_R_conj`, `reflS_conj_Φ`, `ρ_reflS_conj`,
`reflS_conj_controlMatrix_vertex`); this module is separate so that `StarDomain` and the modules
that import it are not rebuilt.
-/

@[expose] public section

namespace SmoothedPolygons

open Matrix OnePoint

open scoped Pointwise

/-- The rotation `R = exp(Jπ/3)` as an element of `GL₂(ℝ)` (`det R = 1`). -/
noncomputable def rotGL : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero R (by
    have h3 : √3 * √3 = 3 := Real.mul_self_sqrt (by norm_num)
    simp only [R, Matrix.det_fin_two_of]
    nlinarith)

/-- The reflection `S = [[-1, 0], [0, 1]]` across the vertical axis as an element of `GL₂(ℝ)`
(`det S = -1`). -/
noncomputable def reflGL : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero reflS (by simp [reflS, Matrix.det_fin_two_of])

/-- The dihedral group of the hexagon, of order `12`, as the subgroup of `GL₂(ℝ)` generated by
its generators `R` and `S` (§4.6). -/
noncomputable def dihedralGroup : Subgroup (GL (Fin 2) ℝ) := Subgroup.closure {rotGL, reflGL}

/-- The ideal vertices `+∞`, `1/√3`, `-1/√3` of the star domain `𝔥*`, as points of
`ℝℙ¹ = ℝ ∪ {∞}` (§4.6). -/
noncomputable def idealVertices : Set (OnePoint ℝ) :=
  {∞, ((1 / √3 : ℝ) : OnePoint ℝ), ((-(1 / √3) : ℝ) : OnePoint ℝ)}

/-- **§4.6, the action on the ideal vertices** (`sec:dihedral:ideal-vertices`, label of this
formalization). The generators of the dihedral group act on the ideal vertices `±1/√3` and `+∞` of
`𝔥*` by linear fractional transformations on `ℝℙ¹`: `R · (+∞) = 1/√3`, `R · (1/√3) = -1/√3`,
`R · (-1/√3) = +∞`, and `S · (±1/√3) = ∓1/√3`. -/
theorem dihedral_smul_idealVertices :
    rotGL • (∞ : OnePoint ℝ) = ((1 / √3 : ℝ) : OnePoint ℝ) ∧
      rotGL • ((1 / √3 : ℝ) : OnePoint ℝ) = ((-(1 / √3) : ℝ) : OnePoint ℝ) ∧
      rotGL • ((-(1 / √3) : ℝ) : OnePoint ℝ) = ∞ ∧
      reflGL • ((1 / √3 : ℝ) : OnePoint ℝ) = ((-(1 / √3) : ℝ) : OnePoint ℝ) ∧
      reflGL • ((-(1 / √3) : ℝ) : OnePoint ℝ) = ((1 / √3 : ℝ) : OnePoint ℝ) := by
  have h3 : √3 * √3 = 3 := Real.mul_self_sqrt (by norm_num)
  have h3' : √3 ≠ 0 := by positivity
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [smul_infty_eq_ite]
    simp [rotGL, R]
    field_simp
  · rw [smul_some_eq_ite]
    have e1 : √3 / 2 * (√3)⁻¹ + 2⁻¹ = 1 := by field_simp; norm_num
    have e2 : 2⁻¹ * (√3)⁻¹ + -(√3 / 2) = -(√3)⁻¹ := by field_simp; linarith
    simp [rotGL, R, e1, e2]
  · rw [smul_some_eq_ite]
    simp only [rotGL, R, Matrix.GeneralLinearGroup.val_mkOfDetNeZero, Matrix.of_apply,
      Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
      Matrix.cons_val_fin_one]
    rw [ite_eq_left (by field_simp; ring)]
  · rw [smul_some_eq_ite]
    simp [reflGL, reflS]
  · rw [smul_some_eq_ite]
    simp [reflGL, reflS]

/-- **§4.6, the dihedral group permutes the ideal vertices of `𝔥*`**
(`sec:dihedral:ideal-vertices`). Every element `A` of the dihedral group (generated by `R` and `S`)
maps the set `{±1/√3, +∞}` of ideal vertices of `𝔥*` onto itself, acting on `ℝℙ¹` by linear
fractional transformations. -/
theorem dihedral_permutes_idealVertices (A : GL (Fin 2) ℝ) (hA : A ∈ dihedralGroup) :
    A • idealVertices = idealVertices := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := dihedral_smul_idealVertices
  have h6 : reflGL • (∞ : OnePoint ℝ) = ∞ := by
    rw [smul_infty_eq_self_iff]
    simp [reflGL, reflS]
  have hS : dihedralGroup ≤ MulAction.stabilizer (GL (Fin 2) ℝ) idealVertices := by
    rw [dihedralGroup, Subgroup.closure_le]
    intro x hx
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff]
    rcases hx with rfl | rfl
    · simp only [idealVertices, Set.smul_set_insert, Set.smul_set_singleton, h1, h2, h3]
      ext z
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      tauto
    · simp only [idealVertices, Set.smul_set_insert, Set.smul_set_singleton, h4, h5, h6]
      ext z
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      tauto
  exact MulAction.mem_stabilizer_iff.1 (hS hA)

end SmoothedPolygons
